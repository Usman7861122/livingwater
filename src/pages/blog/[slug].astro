---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import { posts, fmt } from '../../data/posts';
export function getStaticPaths() { return posts.map((p) => ({ params: { slug: p.slug }, props: { post: p } })); }
const { post } = Astro.props;
const others = posts.filter((p) => p.slug !== post.slug).slice(0, 3);
const jsonld = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.title, datePublished: post.date, description: post.excerpt, image: post.img, publisher: { '@type': 'Organization', name: 'Living Water Clinic' } };
---
<BaseLayout title={`${post.title} | Living Water Clinic`} description={post.excerpt} solidHeader>
  <script type="application/ld+json" set:html={JSON.stringify(jsonld)} slot="head" />
  <PageHero crumbs={[['Home', '/'], ['Blog', '/blog'], [post.tag]]} eyebrow={`${post.tag} · ${fmt(post.date)}`} title={post.title} image={post.img} imageAlt={post.alt} />
  <article class="section bg-cream-50"><div class="container-x max-w-3xl">
    {post.body.map((b) => (<>
      {b.h && <h2 class="mt-10 font-serif text-2xl text-navy-900 first:mt-0">{b.h}</h2>}
      {b.p?.map((t) => <p class="mt-4 text-lg leading-relaxed text-mist">{t}</p>)}
      {b.ul && <ul class="mt-4 space-y-2 text-lg text-mist">{b.ul.map((t) => <li class="flex gap-3"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-500"></span>{t}</li>)}</ul>}
    </>))}
    <p class="mt-10 rounded-xl bg-navy-900 p-6 text-cream-100"><strong class="text-gold-300">Medical note:</strong> This article is for general information. It is not medical advice. In an emergency, call 911.</p>
    <div class="mt-8 flex flex-wrap gap-3"><a href={post.cta[1]} class="btn btn-navy">{post.cta[0]}</a><a href="/locations" class="btn btn-outline">Find a clinic</a></div>
  </div></article>
  <section class="section bg-cream-100"><div class="container-x">
    <h2 class="font-serif text-3xl text-navy-900">More from our blog</h2>
    <ul class="mt-8 grid gap-5 md:grid-cols-3">{others.map((p) => (<li><a href={`/blog/${p.slug}`} class="block h-full rounded-2xl border border-navy-900/10 bg-white p-6 transition hover:border-gold-500"><p class="text-xs font-semibold tracking-widest text-gold-700 uppercase">{p.tag}</p><h3 class="mt-2 font-serif text-lg text-navy-900">{p.title}</h3></a></li>))}</ul>
  </div></section>
</BaseLayout>
