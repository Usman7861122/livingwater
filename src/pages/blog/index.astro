---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import { posts, fmt } from '../../data/posts';
---
<BaseLayout title="Health Blog | Living Water Clinic" description="Simple, trusted health tips from Living Water Clinic in Tulare County, CA: diabetes, children's health, urgent care and more." solidHeader>
  <PageHero crumbs={[['Home', '/'], ['Blog']]} eyebrow="Blog" title="Health tips <em>you can use.</em>" text="Clear advice from our care team for you and your family." />
  <section class="section bg-cream-50"><div class="container-x">
    <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((p, i) => (
        <li data-reveal style={`--d:${(i % 3) * 70}ms`}>
          <a href={`/blog/${p.slug}`} class="group block h-full overflow-hidden rounded-2xl border border-navy-900/10 bg-white transition hover:border-gold-500 hover:shadow-lg">
            <img src={p.img} alt={p.alt} loading="lazy" width="800" height="500" class="aspect-[16/10] w-full object-cover" />
            <div class="p-6">
              <p class="text-xs font-semibold tracking-widest text-gold-700 uppercase">{p.tag} · {fmt(p.date)}</p>
              <h2 class="mt-3 font-serif text-xl text-navy-900">{p.title}</h2>
              <p class="mt-3 text-mist">{p.excerpt}</p>
              <span class="mt-5 inline-block text-sm font-semibold text-gold-700">Read more →</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div></section>
</BaseLayout>
