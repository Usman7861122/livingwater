---
import ServicePage from '../../../components/sections/ServicePage.astro';
import { services, offers } from '../../../data/servicePages';
import { locations } from '../../../data/site';
export function getStaticPaths() {
  return services.flatMap((svc) => locations.filter((l) => offers(svc, l)).map((l) => ({ params: { service: svc.slug, location: l.id }, props: { svc, location: l } })));
}
const { svc, location } = Astro.props;
---
<ServicePage svc={svc} location={location} />
