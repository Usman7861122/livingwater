---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Icon from '../../components/ui/Icon.astro';
const tel = '+15595543373';
const email = 'ecmteam@livingwaterclinic.com';
const who = [
  'People who visit the hospital or ER often because of chronic conditions like asthma, diabetes or high blood pressure, or who are at risk of this',
  'Adults and youth living with a serious mental illness or a substance use disorder',
  'People at risk of living in a facility, or who just left one',
  'Pregnant or postpartum people in high-risk groups',
  'People who use many medical or behavioral health services',
];
const perks = [
  ['Housing help', 'Finding and keeping a safe place to live.'],
  ['Rides to visits', 'Transportation to your medical appointments.'],
  ['Mental health and rehab', 'Connection to counseling and recovery services.'],
  ['Food support', 'Resources so you and your family can eat well.'],
  ['Appointment reminders', 'We help you remember and keep your visits.'],
  ['Health education', 'Clear, simple teaching about your health.'],
  ['Community referrals', 'Links to local groups that can help.'],
];
const faq: [string, string][] = [
  ['What is Enhanced Care Management?', 'ECM is a Medi-Cal benefit. It gives you a personal Lead Care Manager who helps you with medical, mental health and everyday needs, all in one plan.'],
  ['Does it cost anything?', 'ECM is a Medi-Cal benefit for eligible members of Anthem Blue Cross and Health Net. Call our ECM team to check if you qualify.'],
  ['Who is my Lead Care Manager?', 'A member of our clinic team who works with you, your family, your doctors and community groups. They help you set goals and remove barriers.'],
  ['How do I sign up?', 'Call our ECM team or send an email. We will ask a few questions and tell you the next steps.'],
];
const jsonld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
---
<BaseLayout title="Enhanced Care Management (ECM) | Living Water Clinic" description="Enhanced Care Management is a Medi-Cal benefit that gives you a Lead Care Manager for housing, food, transport and mental health support. Call Living Water Clinic ECM at 559-554-3373 ext. 1104." solidHeader>
  <script type="application/ld+json" set:html={JSON.stringify(jsonld)} slot="head" />
  <PageHero crumbs={[['Home', '/'], ['Enhanced Care Management']]} eyebrow="Enhanced Care Management" title="Care that goes <em>beyond the clinic visit.</em>" text="A Medi-Cal benefit that gives you a personal care manager to help with your health, housing, food, rides and more." image="/images/care.jpg" imageAlt="A caring team member supporting a patient">
    <a href={`tel:${tel}`} class="btn btn-gold"><Icon name="phone" size={18} /> 559-554-3373 ext. 1104</a>
    <a href={`mailto:${email}`} class="btn btn-outline-light">Send an email</a>
  </PageHero>

  <section class="section bg-cream-50">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow" data-reveal>What is ECM?</p>
        <h2 class="h-section mt-5 text-navy-900" data-reveal style="--d:80ms">Help to overcome <em>barriers to better health.</em></h2>
      </div>
      <div class="space-y-5 text-lg leading-relaxed text-mist lg:col-span-7">
        <p data-reveal>Enhanced Care Management (ECM) gives personal support to people with complex medical, mental health and social needs. We connect your care across doctors and community groups, so you get the right help at the right time.</p>
        <p data-reveal style="--d:60ms">ECM is a Medi-Cal benefit for Anthem Blue Cross and Health Net members. You get a Lead Care Manager at our clinic. They help you reach your health goals and remove barriers like housing, food and mental health.</p>
        <p data-reveal style="--d:100ms">Our care team works with you, your family, specialists and community groups. Together we make a plan that fits your life.</p>
      </div>
    </div>
  </section>

  <section class="section bg-cream-100">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow" data-reveal>Who qualifies?</p>
        <h2 class="h-section mt-5 text-navy-900" data-reveal style="--d:80ms">Populations <em>we serve.</em></h2>
        <p class="mt-6 text-lg text-mist" data-reveal style="--d:120ms">You may qualify if you fall into one of these groups. Not sure? Call us. We are happy to check with you.</p>
      </div>
      <ul class="space-y-3 lg:col-span-7">
        {who.map((w, i) => <li class="flex items-start gap-4 rounded-xl border border-navy-900/10 bg-white p-5" data-reveal style={`--d:${i * 50}ms`}><span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-full bg-navy-900 text-gold-400"><Icon name="check" size={16} /></span><span class="text-navy-900">{w}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="on-dark bg-navy-950 section">
    <div class="container-x">
      <p class="eyebrow" data-reveal>Why sign up?</p>
      <h2 class="h-section mt-5 max-w-3xl" data-reveal style="--d:80ms">One care manager. <em>Many ways to help.</em></h2>
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {perks.map(([h, d], i) => (
          <li class="rounded-2xl border border-white/10 bg-white/5 p-6" data-reveal style={`--d:${i * 50}ms`}>
            <span class="font-serif text-xl text-gold-400">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 font-serif text-xl">{h}</h3>
            <p class="mt-2 text-cream-200">{d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-cream-50">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow" data-reveal>FAQ</p>
        <h2 class="h-section mt-5 text-navy-900" data-reveal style="--d:80ms">Questions about <em>ECM.</em></h2>
      </div>
      <div class="divide-y divide-navy-900/10 border-y border-navy-900/10 lg:col-span-8">
        {faq.map(([q, a]) => (
          <details class="group py-5" data-reveal>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-serif text-xl text-navy-900">{q}<span class="text-2xl text-gold-700 transition group-open:rotate-45">+</span></summary>
            <p class="mt-3 max-w-2xl text-mist">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-cream-100 text-center">
    <div class="container-x">
      <h2 class="h-section mx-auto max-w-3xl text-navy-900" data-reveal>Talk to our <em>ECM team.</em></h2>
      <p class="mx-auto mt-5 max-w-xl text-lg text-mist" data-reveal style="--d:80ms">Call or write to see if ECM is right for you or someone you love.</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3" data-reveal style="--d:140ms">
        <a href={`tel:${tel}`} class="btn btn-navy">Call 559-554-3373 ext. 1104</a>
        <a href={`mailto:${email}`} class="btn btn-outline">{email}</a>
      </div>
    </div>
  </section>
</BaseLayout>
