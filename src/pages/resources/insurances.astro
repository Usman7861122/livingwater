---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import { insurance, locations } from '../../data/site';
const main = locations.find((x) => x.id === 'lindsay-medical')!;
---
<BaseLayout title="Accepted Insurance | Living Water Clinic" description="Living Water Clinic accepts Medi-Cal, Medicare, Anthem Blue Cross, Health Net, Aetna, Cigna and more. Self-pay patients are welcome too." solidHeader>
  <PageHero crumbs={[['Home', '/'], ['Resources', '/resources'], ['Insurances']]} eyebrow="Insurance" title="Accepted <em>insurance plans.</em>" text="If you don’t see your insurance in the list, please call the office to confirm.">
    <a href={`tel:${main.tel}`} class="btn btn-gold">Call {main.phone}</a>
  </PageHero>
  <section class="section bg-cream-100"><div class="container-x">
    <ul class="mx-auto flex max-w-5xl flex-wrap justify-center gap-4">
      {insurance.map((p, i) => (
        <li class="w-[calc(50%-0.5rem)] sm:w-[calc(33.333%-0.75rem)] md:w-[calc(25%-0.75rem)]" data-reveal style={`--d:${(i % 4) * 60}ms`}>
          <div class="grid aspect-[3/2] place-items-center rounded-2xl border border-navy-900/10 bg-white p-5"><img src={`/images/insurance/${p.file}.webp`} alt={p.name} width="420" height="200" loading="lazy" class="max-h-16 w-auto max-w-full object-contain" /></div>
          <p class="mt-2 text-center text-sm text-mist">{p.name}</p>
        </li>
      ))}
    </ul>
  </div></section>
  <section class="section bg-cream-50"><div class="container-x grid gap-10 lg:grid-cols-2">
    <div class="rounded-2xl border border-navy-900/10 bg-white p-8" data-reveal><h2 class="font-serif text-2xl text-navy-900">No insurance? You are welcome.</h2><p class="mt-3 text-mist">We also accept non-insured, cash-pay patients. Charges vary by the type of diagnosis and the time spent with your provider.</p><a href="/resources/pricing" class="link-underline mt-5 inline-block font-semibold text-navy-900">See pricing and fee discounts</a></div>
    <div class="rounded-2xl border border-navy-900/10 bg-white p-8" data-reveal style="--d:80ms"><h2 class="font-serif text-2xl text-navy-900">Not sure about your plan?</h2><p class="mt-3 text-mist">Plans change often. Call your nearest clinic and our team will check your coverage before your visit.</p><a href="/contact" class="link-underline mt-5 inline-block font-semibold text-navy-900">Find a clinic</a></div>
  </div></section>
</BaseLayout>
