---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import { faqs } from '../../data/resources';
const jsonld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
---
<BaseLayout title="Frequently Asked Questions | Living Water Clinic" description="Answers about our Sliding Fee Discount Program, insurance, self-pay, languages and locations at Living Water Clinic in Tulare and Fresno Counties." solidHeader>
  <script type="application/ld+json" set:html={JSON.stringify(jsonld)} slot="head" />
  <PageHero crumbs={[['Home', '/'], ['Resources', '/resources/'], ['FAQ']]} eyebrow="FAQ" title="Your questions, <em>answered.</em>" text="Can’t find your answer? Call your nearest clinic. We are happy to help." />
  <section class="section bg-cream-100"><div class="container-x max-w-4xl"><div class="rounded-2xl border border-gold-500/40 bg-white p-8" data-reveal><h2 class="font-serif text-2xl text-navy-900">Patient Registration &amp; Self Check-In</h2><p class="mt-3 text-mist">Save time before your appointment by completing your registration and check-in through Phreesia. Follow the secure link sent to you by text message or email to update your information and complete required forms.</p><p class="mt-3 text-sm text-mist">Online appointment scheduling and registration use Phreesia. Your patient portal and medical records are on Athenahealth.</p></div></div></section>
  <section class="section bg-cream-50"><div class="container-x max-w-4xl">
    <div class="divide-y divide-navy-900/10 border-y border-navy-900/10">
      {faqs.map(([q, a]) => (
        <details class="group py-5" data-reveal><summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-serif text-xl text-navy-900">{q}<span class="text-2xl text-gold-700 transition group-open:rotate-45">+</span></summary><p class="mt-3 max-w-2xl text-mist">{a}</p></details>
      ))}
    </div>
  </div></section>
</BaseLayout>
