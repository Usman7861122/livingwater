---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import { locations } from '../../data/site';
const themes = [['Friendly and caring', 'Patients often say our teams make them feel like family.'], ['Time to listen', 'Providers take time to hear your concerns and answer questions.'], ['Helpful, efficient staff', 'From the front desk to the exam room, our team works to make visits smooth.']];
const main = locations.find((x) => x.id === 'lindsay-medical')!;
---
<BaseLayout title="Patient Testimonials | Living Water Clinic" description="See what patients say about Living Water Clinic and Clínica Agua Viva in Tulare County, CA." solidHeader>
  <PageHero crumbs={[['Home', '/'], ['Resources', '/resources'], ['Testimonials']]} eyebrow="Testimonials" title="Trusted by <em>our neighbors.</em>" text="Our patients share their experiences on Google. Here is what they often tell us." />
  <section class="section bg-cream-50"><div class="container-x">
    <ul class="grid gap-5 md:grid-cols-3">
      {themes.map(([t, d], i) => (<li class="rounded-2xl border border-navy-900/10 bg-white p-8" data-reveal style={`--d:${i * 80}ms`}><h2 class="font-serif text-2xl text-navy-900">{t}</h2><p class="mt-3 text-mist">{d}</p></li>))}
    </ul>
    <div class="mt-12 rounded-2xl bg-navy-900 p-10 text-center text-cream-100" data-reveal>
      <h2 class="font-serif text-3xl">Read and share reviews on Google</h2>
      <p class="mx-auto mt-3 max-w-xl text-cream-200">All reviews are posted by real patients on Google. Tell us about your visit.</p>
      <a href="https://www.google.com/search?q=Living+Water+Clinic+Lindsay+CA+reviews" target="_blank" rel="noopener noreferrer" class="btn btn-gold mt-6">See Google reviews</a>
    </div>
    <p class="mt-6 text-sm text-mist">Questions about your care? Call us at {main.phone}. Please do not share private health details in public reviews.</p>
  </div></section>
</BaseLayout>
