---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Icon from '../../components/ui/Icon.astro';
import { locations } from '../../data/site';
const main = locations.find((x) => x.id === 'lindsay-medical')!;
const ways = [
  ['Insurance', 'We accept Medi-Cal, Medicare and many private plans. Your plan decides your copay.', '/resources/insurances', 'See accepted plans'],
  ['Sliding Fee Discount Program', 'Lower fees for patients at or below 200 percent of the Federal Poverty Guidelines. Offered at all Living Water Clinic and Clínica Agua Viva locations.', '/resources/faq', 'Read the FAQ'],
  ['Self-pay', 'No insurance? You are welcome. Charges depend on the type of visit and the time spent with your provider.', '/contact', 'Find a clinic'],
];
---
<BaseLayout title="Pricing and Payment Options | Living Water Clinic" description="Learn about insurance, our Sliding Fee Discount Program and self-pay options at Living Water Clinic in Tulare County." solidHeader>
  <PageHero crumbs={[['Home', '/'], ['Resources', '/resources'], ['Pricing']]} eyebrow="Pricing" title="Care that fits <em>your budget.</em>" text="Everyone deserves good health care. We offer more than one way to pay.">
    <a href={`tel:${main.tel}`} class="btn btn-gold"><Icon name="phone" size={18} /> Ask about costs: {main.phone}</a>
  </PageHero>
  <section class="section bg-cream-50"><div class="container-x">
    <div class="grid gap-5 md:grid-cols-3">
      {ways.map(([t, d, h, c], i) => (
        <div class="flex flex-col rounded-2xl border border-navy-900/10 bg-white p-8" data-reveal style={`--d:${i * 80}ms`}>
          <span class="font-serif text-2xl text-gold-700">{String(i + 1).padStart(2, '0')}</span>
          <h2 class="mt-3 font-serif text-2xl text-navy-900">{t}</h2><p class="mt-3 flex-1 text-mist">{d}</p>
          <a href={h} class="link-underline mt-6 font-semibold text-navy-900">{c}</a>
        </div>
      ))}
    </div>
    <p class="mt-8 max-w-3xl text-mist" data-reveal>We do not list fixed prices online because the cost depends on your visit. Call your nearest clinic for an estimate before you come in.</p>
  </div></section>
</BaseLayout>
