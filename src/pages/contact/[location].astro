---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/ui/Icon.astro';
import ContactForm from '../../components/islands/ContactForm';
import { locations, dentalServices, insurance } from '../../data/site';
import { bySlug, svcPath, categories, siblingOf } from '../../data/servicePages';

export function getStaticPaths() {
  return locations.map((location) => ({ params: { location: location.id }, props: { location } }));
}
const { location } = Astro.props;
const isDental = location.type === 'Dental';
const sib = siblingOf(location);
const dentalSib = !isDental ? locations.find((x) => x.city === location.city && x.type === 'Dental') : undefined;
const others = locations.filter((x) => x.id !== location.id).sort((a, b) => a.city.localeCompare(b.city) || a.name.localeCompare(b.name));
const full = `${location.address}, ${location.cityLine}`;
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(`Living Water Clinic ${full}`)}&output=embed`;
const dirHref = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(full)}`;
const title = `${location.name} in ${location.city}, CA | Living Water Clinic`;
const description = isDental
  ? `${location.name} at ${full}. Checkups, cleanings, fillings and family dental care in ${location.city}, CA. Call ${location.phone}.`
  : `${location.name} at ${full}. Family medicine, pediatrics, chronic care and specialty services in ${location.city}, CA. Call ${location.phone}.`;
const canonical = new URL(`/contact/${location.id}`, Astro.site ?? 'https://livingwaterclinic.com').href;
const ld = {
  '@context': 'https://schema.org',
  '@type': isDental ? 'Dentist' : 'MedicalClinic',
  name: `Living Water Clinic – ${location.name}`, url: canonical, telephone: location.phone,
  address: { '@type': 'PostalAddress', streetAddress: location.address, addressLocality: location.city, addressRegion: 'CA', postalCode: location.cityLine.slice(-5), addressCountry: 'US' },
  geo: { '@type': 'GeoCoordinates', latitude: location.lat, longitude: location.lng },
};
const facts = [
  ['Address', `${location.address}\n${location.cityLine}`],
  ['Phone', location.phone],
  ['Hours', 'Please call us for current hours'],
  ['Languages', 'English and Spanish'],
];
---

<BaseLayout title={title} description={description} solidHeader>
  <Fragment slot="head">
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </Fragment>

  <section class="on-dark relative overflow-hidden bg-navy-950 pt-36 pb-20 lg:pt-44">
    <div class="container-x grid items-center gap-12 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <nav aria-label="Breadcrumb" class="text-sm text-cream-200/80" data-reveal><a href="/" class="link-underline">Home</a> <span class="mx-2">/</span> <a href="/#locations" class="link-underline">Locations</a> <span class="mx-2">/</span> <span class="text-gold-400">{location.name}</span></nav>
        <p class="eyebrow mt-8" data-reveal style="--d:60ms">{location.type} clinic · {location.city}</p>
        <h1 class="h-display mt-5" data-reveal style="--d:120ms">{location.name}<br /><em>in {location.city}, CA</em></h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-cream-200" data-reveal style="--d:180ms">
          {isDental
            ? `Friendly, gentle dental care for the whole family in ${location.city}. Checkups, cleanings, fillings and more, in English or Spanish.`
            : `Compassionate, faith-based care for the whole family in ${location.city}. Primary care, chronic care and specialty services, in English or Spanish.`}
        </p>
        <div class="mt-9 flex flex-wrap gap-3" data-reveal style="--d:240ms">
          <a href={`tel:${location.tel}`} class="btn btn-gold"><Icon name="phone" size={18} /> {location.phone}</a>
          <a href={dirHref} target="_blank" rel="noopener" class="btn btn-outline-light">Get directions</a>
        </div>
      </div>
      <div class="lg:col-span-6" data-reveal style="--d:200ms">
        <div class="relative">
          <div class="absolute -right-3 -bottom-3 h-full w-full rounded-2xl border border-gold-400/60"></div>
          <img src={isDental ? '/images/dental.jpg' : '/images/services/family-medicine/hero.jpg'} alt={`${location.name} care team in ${location.city}`} width="1600" height="1067" class="relative aspect-[4/3] w-full rounded-2xl object-cover" fetchpriority="high" />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-cream-50 py-14">
    <div class="container-x">
      <dl class="grid gap-px overflow-hidden rounded-2xl border border-navy-900/10 bg-navy-900/10 sm:grid-cols-2 lg:grid-cols-4">
        {facts.map(([k, v], i) => (
          <div class="bg-white p-7" data-reveal style={`--d:${i * 60}ms`}>
            <dt class="text-xs font-semibold tracking-widest text-gold-700 uppercase">{k}</dt>
            <dd class="mt-3 whitespace-pre-line font-serif text-xl text-navy-900">{k === 'Phone' ? <a href={`tel:${location.tel}`} class="link-underline">{v}</a> : v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section id="services" class="section bg-cream-50 !pt-4">
    <div class="container-x">
      <p class="eyebrow" data-reveal>Services at {location.name}</p>
      <h2 class="h-section mt-5 max-w-3xl text-navy-900" data-reveal style="--d:80ms">{isDental ? <>Dental care <em>for every smile.</em></> : <>What we offer <em>in {location.city}.</em></>}</h2>

      {isDental ? (
        <div class="mt-10 grid gap-6 lg:grid-cols-12">
          <ul class="grid gap-3 sm:grid-cols-2 lg:col-span-8">
            {dentalServices.map((s, i) => (
              <li class="flex items-start gap-4 rounded-xl border border-navy-900/10 bg-white p-5" data-reveal style={`--d:${i * 50}ms`}>
                <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-full bg-navy-900 text-gold-400"><Icon name="check" size={16} /></span>
                <span class="font-serif text-lg text-navy-900">{s.en}</span>
              </li>
            ))}
          </ul>
          {sib && (
            <aside class="rounded-2xl bg-navy-900 p-8 text-cream-50 lg:col-span-4" data-reveal>
              <p class="text-xs font-semibold tracking-widest text-gold-400 uppercase">Need medical care too?</p>
              <p class="mt-4 text-lg text-cream-200">Our medical clinic in {location.city} offers family medicine and specialty care.</p>
              <a href={`/contact/${sib.id}`} class="btn btn-gold mt-6">See {sib.name}</a>
            </aside>
          )}
        </div>
      ) : (
        <div class="mt-10 space-y-12">
          {categories.map((c) => (
            <div>
              <h3 class="font-serif text-2xl text-navy-900" data-reveal>{c.eyebrow}</h3>
              <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                {c.items.map((slug, i) => {
                  const s = bySlug[slug];
                  return (
                    <li data-reveal style={`--d:${i * 50}ms`}>
                      <a href={svcPath(s, location)} class="group flex h-full items-center justify-between gap-3 rounded-xl border border-navy-900/10 bg-white px-5 py-5 transition hover:border-gold-500 hover:shadow-md">
                        <span class="font-serif text-lg leading-snug text-navy-900">{s.title}</span>
                        <span class="text-gold-700 transition group-hover:translate-x-1"><Icon name="arrow" size={18} /></span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
          {dentalSib && (
            <p class="text-lg text-mist" data-reveal>Looking for dental care? Visit <a href={`/contact/${dentalSib.id}`} class="link-underline text-navy-900">{dentalSib.name}</a> in {location.city}.</p>
          )}
        </div>
      )}
    </div>
  </section>

  <section class="bg-cream-100 section">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow" data-reveal>Visit us</p>
        <h2 class="h-section mt-5 text-navy-900" data-reveal style="--d:80ms">Find us in <em>{location.city}.</em></h2>
        <p class="mt-6 text-lg leading-relaxed text-mist" data-reveal style="--d:120ms">{location.address}<br />{location.cityLine}</p>
        <p class="mt-6 text-lg leading-relaxed text-mist" data-reveal style="--d:160ms">We accept many insurance plans, including Medi-Cal and Medicare. Bring your ID and insurance card to your first visit.</p>
        <div class="mt-8 flex flex-wrap gap-3" data-reveal style="--d:200ms">
          <a href={`tel:${location.tel}`} class="btn btn-navy"><Icon name="phone" size={18} /> {location.phone}</a>
          <a href={dirHref} target="_blank" rel="noopener" class="btn btn-outline">Get directions</a>
        </div>
      </div>
      <div class="lg:col-span-7" data-reveal style="--d:120ms">
        <iframe title={`Map of ${location.name}`} src={mapSrc} loading="lazy" class="h-96 w-full rounded-2xl border-0 shadow-lg lg:h-full lg:min-h-[26rem]" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>

  <section id="contact" class="section bg-cream-50">
    <div class="container-x grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow" data-reveal>Get in touch</p>
        <h2 class="h-section mt-5 text-navy-900" data-reveal style="--d:80ms">Message our <em>{location.city} team.</em></h2>
        <p class="mt-6 text-lg leading-relaxed text-mist" data-reveal style="--d:160ms">Send us a note and a team member at {location.name} will reach out. Prefer to talk? Call {location.phone}.</p>
      </div>
      <div class="lg:col-span-7" data-reveal style="--d:120ms"><ContactForm client:visible /></div>
    </div>
  </section>

  <section class="on-dark bg-navy-950 section">
    <div class="container-x">
      <p class="eyebrow" data-reveal>Other locations</p>
      <h2 class="h-section mt-5 max-w-3xl" data-reveal style="--d:80ms">6 more clinics <em>across Tulare County.</em></h2>
      <ul class="mt-10 grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-3">
        {others.map((x) => (
          <li class="bg-navy-950">
            <a href={`/contact/${x.id}`} class="group flex h-full items-center justify-between gap-4 p-7 transition hover:bg-navy-900">
              <div>
                <p class="text-xs tracking-widest text-gold-400 uppercase">{x.city} · {x.type}</p>
                <p class="mt-2 font-serif text-xl">{x.name}</p>
                <p class="mt-1 text-sm text-cream-200/80">{x.address}, {x.cityLine}</p>
              </div>
              <span class="text-gold-400 transition group-hover:translate-x-1"><Icon name="arrow" size={20} /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
