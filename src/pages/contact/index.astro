---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/ui/Icon.astro';
import { locations } from '../../data/site';
const groups = [['Medical clinics', locations.filter((x) => x.type === 'Medical')], ['Dental clinics', locations.filter((x) => x.type === 'Dental')]] as const;
---
<BaseLayout title="Locations | Living Water Clinic" description="Seven Living Water Clinic locations in Lindsay, Woodlake, Porterville, Visalia and Selma, California. Find the clinic nearest you." solidHeader>
  <section class="on-dark bg-navy-950 pt-36 pb-16 lg:pt-44">
    <div class="container-x">
      <nav aria-label="Breadcrumb" class="text-sm text-cream-200/80" data-reveal><a href="/" class="link-underline">Home</a> <span class="mx-2">/</span> <span class="text-gold-400">Locations</span></nav>
      <p class="eyebrow mt-8" data-reveal>Our locations</p>
      <h1 class="h-display mt-5 max-w-3xl" data-reveal style="--d:80ms">Seven clinics, <em>one family.</em></h1>
      <p class="mt-6 max-w-xl text-lg text-cream-200" data-reveal style="--d:140ms">Find the Living Water Clinic closest to you in Tulare County.</p>
    </div>
  </section>
  {groups.map(([label, list], gi) => (
    <section class={`section ${gi === 0 ? 'bg-cream-50' : 'bg-cream-100'}`}>
      <div class="container-x">
        <h2 class="h-section text-navy-900" data-reveal>{label}</h2>
        <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {list.map((x, i) => (
            <li data-reveal style={`--d:${i * 60}ms`}>
              <a href={`/contact/${x.id}`} class="group block h-full rounded-2xl border border-navy-900/10 bg-white p-8 transition hover:border-gold-500 hover:shadow-lg">
                <p class="text-xs font-semibold tracking-widest text-gold-700 uppercase">{x.city}</p>
                <h3 class="mt-3 font-serif text-2xl text-navy-900">{x.name}</h3>
                <p class="mt-4 text-mist">{x.address}<br />{x.cityLine}</p>
                <p class="mt-3 font-semibold text-navy-900">{x.phone}</p>
                <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-gold-700">View location <span class="transition group-hover:translate-x-1"><Icon name="arrow" size={16} /></span></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}
</BaseLayout>
