---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Icon from '../../components/ui/Icon.astro';
import { locations } from '../../data/site';
const lindsay = locations.find((x) => x.id === 'lindsay-dental')!;
const groups: [string, string, string[]][] = [
  ['Prevent', 'Stop problems before they start.', ['Exams and professional cleanings', 'Digital X-rays', 'Fluoride treatments and sealants', 'Oral cancer screenings', 'Gum disease care']],
  ['Restore', 'Fix and protect your teeth.', ['Cavities and tooth-colored fillings', 'Crowns and bridges', 'Root canals', 'Dental implants', 'Partials and dentures']],
  ['Relieve', 'Help when something hurts.', ['Emergency dentistry', 'Tooth extractions', 'Wisdom teeth removal', 'Care for children, from the first visit', 'Gentle care for nervous patients']],
];
const faq: [string, string][] = [
  ['Why are regular dental checkups important?', 'Checkups let your dentist find problems early, before they become serious. Cleanings remove plaque and tartar that brushing and flossing can miss. Early care is usually simpler, easier and cheaper.'],
  ['How often should I visit the dentist?', 'Many people do well with a visit every six months. Your dentist may suggest a different schedule based on your age, health, habits and past dental problems.'],
  ['What is included in general dental care?', 'General care often includes exams, cleanings, digital X-rays, cavity checks, fluoride and oral cancer screenings. Dentists can also do fillings, crowns and other treatments that protect your natural teeth.'],
  ['How can I keep my teeth healthy at home?', 'Brush twice a day with fluoride toothpaste, floss daily, limit sugary food and drinks, drink water and avoid tobacco. Keep your regular checkups, too.'],
  ['What should I expect at my first visit?', 'We review your medical and dental history, talk about your concerns and examine your teeth, gums and mouth. X-rays may be taken. Then we explain what we found and plan your care together.'],
];
const benefits = ['Find cavities and gum disease early', 'Avoid pain, big procedures and extra costs', 'Support healthy eating, clear speech and confidence', 'Lower the risk of problems linked to other health conditions'];
---
<BaseLayout title="Dental Services | Living Water Clinic" description="Cleanings, fillings, crowns, root canals, implants, dentures, emergency dentistry, wisdom teeth and gum disease care for kids and adults in Lindsay and Visalia, CA." solidHeader>
  <PageHero crumbs={[['Home', '/'], ['Dental', '/dental'], ['Dental Services']]} eyebrow="Dental services" title="Dental care <em>from checkups to crowns.</em>" text="Compassionate, patient-centered dental services for children and adults, in a comfortable and welcoming place.">
    <a href={`tel:${lindsay.tel}`} class="btn btn-gold"><Icon name="phone" size={18} /> {lindsay.phone}</a>
    <a href="/#contact" class="btn btn-outline-light">Request an appointment</a>
  </PageHero>

  <section class="section bg-cream-50">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow" data-reveal>Benefits</p>
        <h2 class="h-section mt-5 text-navy-900" data-reveal style="--d:80ms">Why regular dental care <em>matters.</em></h2>
      </div>
      <div class="lg:col-span-7">
        <p class="text-lg leading-relaxed text-mist" data-reveal>Routine dental care does more than keep teeth looking good. Exams, cleanings and screenings can catch cavities, gum disease and other concerns at the earliest stage. Healthy teeth and gums also support good nutrition, clear speech and self-confidence.</p>
        <ul class="mt-8 grid gap-3 sm:grid-cols-2">
          {benefits.map((b, i) => <li class="flex items-start gap-3 rounded-xl border border-navy-900/10 bg-white p-5" data-reveal style={`--d:${i * 50}ms`}><span class="mt-0.5 text-gold-700"><Icon name="check" size={18} /></span><span class="text-navy-900">{b}</span></li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section bg-cream-100">
    <div class="container-x">
      <p class="eyebrow" data-reveal>Our services</p>
      <h2 class="h-section mt-5 max-w-3xl text-navy-900" data-reveal style="--d:80ms">Prevent. Restore. <em>Relieve.</em></h2>
      <div class="mt-12 grid gap-5 md:grid-cols-3">
        {groups.map(([h, d, items], gi) => (
          <div class="rounded-2xl border border-navy-900/10 bg-white p-8" data-reveal style={`--d:${gi * 80}ms`}>
            <span class="font-serif text-2xl text-gold-700">{String(gi + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 font-serif text-3xl text-navy-900">{h}</h3>
            <p class="mt-2 text-mist">{d}</p>
            <ul class="mt-6 space-y-3">
              {items.map((it) => <li class="flex items-start gap-3 text-navy-900"><span class="mt-1 text-gold-700"><Icon name="check" size={16} /></span>{it}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <p class="mt-8 text-sm text-mist" data-reveal>Services can differ by clinic. Call your nearest dental office to check what is offered.</p>
    </div>
  </section>

  <section class="section bg-cream-50">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <p class="eyebrow" data-reveal>FAQ</p>
        <h2 class="h-section mt-5 text-navy-900" data-reveal style="--d:80ms">Dental questions, <em>answered.</em></h2>
      </div>
      <div class="divide-y divide-navy-900/10 border-y border-navy-900/10 lg:col-span-8">
        {faq.map(([q, a]) => (
          <details class="group py-5" data-reveal>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 font-serif text-xl text-navy-900">{q}<span class="text-2xl text-gold-700 transition group-open:rotate-45">+</span></summary>
            <p class="mt-3 max-w-2xl text-mist">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="on-dark bg-navy-950 section text-center">
    <div class="container-x">
      <h2 class="h-section mx-auto max-w-3xl" data-reveal>Your smile starts <em>here.</em></h2>
      <p class="mx-auto mt-5 max-w-xl text-lg text-cream-200" data-reveal style="--d:80ms">Now accepting new dental patients. We accept Medi-Cal, Medicaid and most private insurance.</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3" data-reveal style="--d:140ms">
        <a href="/#contact" class="btn btn-gold">Request an appointment</a>
        <a href="/locations/lindsay-dental" class="btn btn-outline-light">Lindsay Dental</a>
        <a href="/locations/visalia-dental" class="btn btn-outline-light">Visalia Dental</a>
      </div>
    </div>
  </section>
</BaseLayout>
