---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Icon from '../../components/ui/Icon.astro';
import { locations } from '../../data/site';
import { providers } from '../../data/providers';

const dentalLocs = locations.filter((x) => x.type === 'Dental');
const lindsay = dentalLocs.find((x) => x.id === 'lindsay-dental')!;
const dentists = providers.filter((p) => p.cat === 'dental');
const kids = [
  'Free check-ups for children with Medi-Cal',
  'Exams, cleanings, fluoride treatments and sealants to get ready for school',
  'Fillings and extractions when needed',
  'A calm, friendly approach so kids feel safe',
  'Tips for parents and kids on brushing, flossing and healthy food',
];
const all = ['Digital X-rays', 'Routine and deep cleanings', 'Preventive dental care', 'Exams and fluoride for kids', 'Tooth-colored fillings, crowns and bridges', 'Root canals', 'Tooth extractions', 'Partials and dentures'];
const why = ['Now accepting new dental patients', 'Over 20 years of trusted dental care', 'Walk-ins welcome when available', 'A warm, caring place', 'Bilingual staff who speak English and Spanish'];
---
<BaseLayout title="Dental Care for Kids, Adults and Families | Living Water Clinic" description="Complete dental care for the whole family in Lindsay and Visalia, CA. Now accepting new patients. We accept Medi-Cal, Medicaid and most private insurance." solidHeader>
  <PageHero crumbs={[['Home', '/'], ['Dental']]} eyebrow="Dental" title="Complete dental care <em>for the whole family.</em>" text="Now accepting new dental patients: kids, adults and families. Kind, gentle and trusted care in Lindsay and Visalia." image="/images/dental.jpg" imageAlt="Friendly dental care for the whole family">
    <a href={`tel:${lindsay.tel}`} class="btn btn-gold"><Icon name="phone" size={18} /> {lindsay.phone}</a>
    <a href="/dental/services" class="btn btn-outline-light">Dental services</a>
    <p class="w-full text-sm text-cream-200/80">We accept Medi-Cal, Medicaid and most private insurance plans.</p>
  </PageHero>

  <section class="section bg-cream-50">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow" data-reveal>Healthy smiles</p>
        <h2 class="h-section mt-5 text-navy-900" data-reveal style="--d:80ms">Good oral health is part of <em>whole-body health.</em></h2>
      </div>
      <div class="space-y-5 text-lg leading-relaxed text-mist lg:col-span-7">
        <p data-reveal>Dental care focuses on preventing, finding and treating problems of the teeth, gums and mouth. Regular visits keep your smile healthy and help us spot small concerns before they become serious.</p>
        <p data-reveal style="--d:60ms">At Living Water Clinic, you get compassionate, patient-centered dental care in a comfortable, welcoming place. We take time to explain things, build a plan for you and help you build habits for lasting oral health.</p>
        <a href="/dental/services" class="link-underline inline-block font-semibold text-navy-900" data-reveal style="--d:120ms">See all dental services</a>
      </div>
    </div>
  </section>

  <section class="section bg-cream-100">
    <div class="container-x grid items-center gap-12 lg:grid-cols-12">
      <figure class="lg:col-span-4" data-reveal>
        <img src="/images/doctors/alma-sanchez.webp" alt="Dr. Alma Sanchez, D.D.S." width="500" height="600" loading="lazy" class="aspect-[4/5] w-full rounded-2xl object-cover object-top" />
      </figure>
      <div class="lg:col-span-8">
        <p class="eyebrow" data-reveal>Meet our lead dentist</p>
        <h2 class="h-section mt-5 text-navy-900" data-reveal style="--d:80ms">Dr. Alma Sanchez, D.D.S. <em>20+ years of experience.</em></h2>
        <p class="mt-6 text-lg leading-relaxed text-mist" data-reveal style="--d:120ms">Dr. Sanchez has cared for children and adults for more than 20 years. She gives calm, skilled care and speaks English and Spanish.</p>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {['Specializes in child and family dental care', 'Trusted by parents and loved by kids', 'Comfortable with patients of all ages', 'Fluent in Spanish and English'].map((t, i) => (
            <li class="flex items-start gap-3" data-reveal style={`--d:${i * 50}ms`}><span class="mt-0.5 grid h-7 w-7 shrink-0 place-items-center rounded-full bg-navy-900 text-gold-400"><Icon name="check" size={14} /></span><span class="text-navy-900">{t}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section bg-cream-50">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow" data-reveal>Pediatric dental care</p>
        <h2 class="h-section mt-5 text-navy-900" data-reveal style="--d:80ms">First year, first tooth, <em>first dental visit.</em></h2>
        <p class="mt-6 text-lg leading-relaxed text-mist" data-reveal style="--d:120ms">A first visit by your child’s first birthday builds a lifetime of healthy smiles. Early check-ups catch problems before they start. They also give parents tools to care for their child’s teeth as they grow.</p>
      </div>
      <div class="lg:col-span-7">
        <p class="font-serif text-xl text-navy-900" data-reveal>We care for children of all ages:</p>
        <ul class="mt-5 space-y-3">
          {kids.map((k, i) => (
            <li class="flex items-start gap-4 rounded-xl border border-navy-900/10 bg-white p-5" data-reveal style={`--d:${i * 50}ms`}><span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-full bg-navy-900 text-gold-400"><Icon name="check" size={16} /></span><span class="text-mist">{k}</span></li>
          ))}
        </ul>
        <p class="mt-6 rounded-xl bg-navy-900 p-6 text-cream-100" data-reveal><strong class="text-gold-300">Did you know?</strong> Children must have a dental screening before they start Kindergarten. An early first visit helps meet this rule.</p>
      </div>
    </div>
  </section>

  <section class="on-dark bg-navy-950 section">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <p class="eyebrow" data-reveal>Complete dental services for all ages</p>
        <h2 class="h-section mt-5" data-reveal style="--d:80ms">Everything your smile needs, <em>in one place.</em></h2>
        <p class="mt-6 text-lg text-cream-200" data-reveal style="--d:120ms">Our Mirage Avenue clinic in Lindsay now provides:</p>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {all.map((a, i) => <li class="flex items-center gap-3 text-cream-100" data-reveal style={`--d:${i * 40}ms`}><span class="text-gold-400"><Icon name="check" size={18} /></span>{a}</li>)}
        </ul>
        <a href="/dental/services" class="btn btn-gold mt-8">All dental services</a>
      </div>
      <div class="lg:col-span-6">
        <p class="eyebrow" data-reveal>Why families choose us</p>
        <ul class="mt-6 space-y-4">
          {why.map((w, i) => <li class="rounded-xl border border-white/10 bg-white/5 px-6 py-5 font-serif text-xl" data-reveal style={`--d:${i * 60}ms`}>{w}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section bg-cream-100">
    <div class="container-x">
      <p class="eyebrow" data-reveal>Our dentists</p>
      <h2 class="h-section mt-5 text-navy-900" data-reveal style="--d:80ms">Gentle hands, <em>friendly faces.</em></h2>
      <ul class="mt-10 grid gap-6 sm:grid-cols-3">
        {dentists.map((d, i) => (
          <li class="rounded-2xl border border-navy-900/10 bg-white p-3 pb-5 shadow-sm" data-reveal style={`--d:${i * 70}ms`}>
            <div class="overflow-hidden rounded-xl bg-cream-200"><img src={`/images/doctors/${d.slug}.webp`} alt={`${d.name}, ${d.creds}`} loading="lazy" width="500" height="600" class="aspect-[4/5] w-full object-cover object-top" /></div>
            <h3 class="mt-4 px-1 font-serif text-xl text-navy-900">{d.name}<span class="block text-base text-mist">{d.creds}</span></h3>
            <p class="mt-2 px-1 text-sm font-semibold tracking-wide text-gold-700 uppercase">{d.role}</p>
          </li>
        ))}
      </ul>
      <a href="/providers#dental" class="link-underline mt-8 inline-block font-semibold text-navy-900" data-reveal>See all dental providers</a>
    </div>
  </section>

  <section class="section bg-cream-50">
    <div class="container-x">
      <p class="eyebrow" data-reveal>Dental locations</p>
      <h2 class="h-section mt-5 text-navy-900" data-reveal style="--d:80ms">Find a dental <em>clinic near you.</em></h2>
      <ul class="mt-10 grid gap-5 md:grid-cols-2">
        {dentalLocs.map((x, i) => (
          <li data-reveal style={`--d:${i * 70}ms`}>
            <a href={`/contact/${x.id}`} class="group block h-full rounded-2xl border border-navy-900/10 bg-white p-8 transition hover:border-gold-500 hover:shadow-lg">
              <p class="text-xs font-semibold tracking-widest text-gold-700 uppercase">{x.city}</p>
              <h3 class="mt-3 font-serif text-2xl text-navy-900">{x.name}</h3>
              <p class="mt-4 text-mist">{x.address}<br />{x.cityLine}</p>
              <p class="mt-3 font-semibold text-navy-900">{x.phone}</p>
              <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-gold-700">View location <span class="transition group-hover:translate-x-1"><Icon name="arrow" size={16} /></span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-cream-100 text-center">
    <div class="container-x">
      <h2 class="h-section mx-auto max-w-3xl text-navy-900" data-reveal>Your smile starts <em>here.</em></h2>
      <p class="mx-auto mt-5 max-w-xl text-lg text-mist" data-reveal style="--d:80ms">Now accepting new dental patients. Call us or send a message to book your visit.</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3" data-reveal style="--d:140ms">
        <a href="/#contact" class="btn btn-navy">Request an appointment</a>
        <a href={`tel:${lindsay.tel}`} class="btn btn-outline">Call {lindsay.phone}</a>
      </div>
    </div>
  </section>
</BaseLayout>
