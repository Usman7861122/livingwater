---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/ui/Icon.astro';
import ContactForm from '../../components/islands/ContactForm';
import { locations, dentalServices, insurance } from '../../data/site';
import { bySlug, svcPath, categories, siblingOf } from '../../data/servicePages';
import { locationContent } from '../../data/locationContent';

export function getStaticPaths() {
  return locations.map((location) => ({ params: { location: location.id }, props: { location } }));
}
const { location } = Astro.props;
const isDental = location.type === 'Dental';
const extra = locationContent[location.id];
const hoursLine = extra ? 'Mon – Fri\n8:00 AM – 12:00 PM\n1:00 PM – 5:00 PM' : 'Please call us for current hours';
const sib = siblingOf(location);
const dentalSib = !isDental ? locations.find((x) => x.city === location.city && x.type === 'Dental') : undefined;
const others = locations.filter((x) => x.id !== location.id).sort((a, b) => a.city.localeCompare(b.city) || a.name.localeCompare(b.name));
const full = `${location.address}, ${location.cityLine}`;
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(`Living Water Clinic ${full}`)}&output=embed`;
const dirHref = `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(full)}`;
const careLabel = isDental ? 'Dental Care' : 'Medical Care';
const title = `${careLabel} in ${location.city}, CA | Living Water Clinic`;
const description = isDental
  ? `${location.name} at ${full}. Checkups, cleanings, fillings and family dental care in ${location.city}, CA. Call ${location.phone}.`
  : `${location.name} at ${full}. Family medicine, pediatrics, chronic care and specialty services in ${location.city}, CA. Call ${location.phone}.`;
const canonical = new URL(`/locations/${location.id}`, Astro.site ?? 'https://livingwaterclinic.com').href;
const ld = {
  '@context': 'https://schema.org',
  '@type': isDental ? 'Dentist' : 'MedicalClinic',
  name: `Living Water Clinic – ${location.name}`, url: canonical, telephone: location.phone,
  address: { '@type': 'PostalAddress', streetAddress: location.address, addressLocality: location.city, addressRegion: 'CA', postalCode: location.cityLine.slice(-5), addressCountry: 'US' },
  geo: { '@type': 'GeoCoordinates', latitude: location.lat, longitude: location.lng },
  ...(extra ? { email: extra.email, openingHoursSpecification: [{ '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:00', closes: '17:00' }], image: extra.gallery.map((g) => new URL(g.src, Astro.site ?? 'https://livingwaterclinic.com').href) } : {}),
};
const facts = [
  ['Address', `${location.address}\n${location.cityLine}`],
  ['Phone', location.phone],
  ['Hours', hoursLine],
  ['Languages', 'English and Spanish'],
];
---

<BaseLayout title={title} description={description} solidHeader>
  <Fragment slot="head">
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </Fragment>

  <section class="on-dark relative overflow-hidden bg-navy-950 pt-36 pb-20 lg:pt-44">
    <div class="container-x grid items-center gap-12 lg:grid-cols-12">
      <div class="lg:col-span-6">
        <nav aria-label="Breadcrumb" class="text-sm text-cream-200/80" data-reveal><a href="/" class="link-underline">Home</a> <span class="mx-2">/</span> <a href="/#locations" class="link-underline">Locations</a> <span class="mx-2">/</span> <span class="text-gold-400">{location.name}</span></nav>
        <p class="eyebrow mt-8" data-reveal style="--d:60ms">Living Water Clinic · {location.name}</p>
        <h1 class="h-display mt-5" data-reveal style="--d:120ms">{careLabel}<br /><em>in {location.city}, CA</em></h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-cream-200" data-reveal style="--d:180ms">
          {isDental
            ? `Friendly, gentle dental care for the whole family in ${location.city}. Checkups, cleanings, fillings and more, in English or Spanish.`
            : extra ? `Compassionate, faith-based care for the whole family at ${location.address}. Primary care, same-day visits, telemedicine, chronic care and specialty services, in English or Spanish.` : `Compassionate, faith-based care for the whole family in ${location.city}. Primary care, chronic care and specialty services, in English or Spanish.`}
        </p>
        <div class="mt-9 flex flex-wrap gap-3" data-reveal style="--d:240ms">
          <a href={`tel:${location.tel}`} class="btn btn-gold"><Icon name="phone" size={18} /> {location.phone}</a>
          <a href={dirHref} target="_blank" rel="noopener" class="btn btn-outline-light">Get directions</a>
        </div>
      </div>
      <div class="lg:col-span-6" data-reveal style="--d:200ms">
        <div class="relative">
          <div class="absolute -right-3 -bottom-3 h-full w-full rounded-2xl border border-gold-400/60"></div>
          <img src={isDental ? '/images/dental.jpg' : '/images/services/family-medicine/hero.jpg'} alt={`${location.name} care team in ${location.city}`} width="1600" height="1067" class="relative aspect-[4/3] w-full rounded-2xl object-cover" fetchpriority="high" />
        </div>
      </div>
    </div>
  </section>

  <section class="bg-cream-50 py-14">
    <div class="container-x">
      <dl class="grid gap-px overflow-hidden rounded-2xl border border-navy-900/10 bg-navy-900/10 sm:grid-cols-2 lg:grid-cols-4">
        {facts.map(([k, v], i) => (
          <div class="bg-white p-7" data-reveal style={`--d:${i * 60}ms`}>
            <dt class="text-xs font-semibold tracking-widest text-gold-700 uppercase">{k}</dt>
            <dd class="mt-3 whitespace-pre-line font-serif text-xl text-navy-900">{k === 'Phone' ? <a href={`tel:${location.tel}`} class="link-underline">{v}</a> : v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {extra && (
    <section class="section bg-cream-50 !pb-4">
      <div class="container-x grid gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <p class="eyebrow" data-reveal>About our clinic</p>
          <h2 class="h-section mt-5 text-navy-900" data-reveal style="--d:80ms">Care close to home, <em>in {location.city}.</em></h2>
        </div>
        <div class="space-y-5 text-lg leading-relaxed text-mist lg:col-span-7">
          {extra.about.map((t, i) => <p data-reveal style={`--d:${i * 60}ms`}>{t}</p>)}
        </div>
      </div>
    </section>
  )}

  <section id="services" class="section bg-cream-50 !pt-4">
    <div class="container-x">
      <p class="eyebrow" data-reveal>Services at {location.name}</p>
      <h2 class="h-section mt-5 max-w-3xl text-navy-900" data-reveal style="--d:80ms">{isDental ? <>Dental care <em>for every smile.</em></> : <>What we offer <em>in {location.city}.</em></>}</h2>

      {isDental ? (
        <div class="mt-10 grid gap-6 lg:grid-cols-12">
          <ul class="grid gap-3 sm:grid-cols-2 lg:col-span-8">
            {(extra ? extra.groups[0].items.map((t) => ({ en: t })) : dentalServices).map((s, i) => (
              <li class="flex items-start gap-4 rounded-xl border border-navy-900/10 bg-white p-5" data-reveal style={`--d:${i * 50}ms`}>
                <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-full bg-navy-900 text-gold-400"><Icon name="check" size={16} /></span>
                <span class="font-serif text-lg text-navy-900">{s.en}</span>
              </li>
            ))}
          </ul>
          {sib && (
            <aside class="rounded-2xl bg-navy-900 p-8 text-cream-50 lg:col-span-4" data-reveal>
              <p class="text-xs font-semibold tracking-widest text-gold-400 uppercase">Need medical care too?</p>
              <p class="mt-4 text-lg text-cream-200">Our medical clinic in {location.city} offers family medicine and specialty care.</p>
              <a href={`/locations/${sib.id}`} class="btn btn-gold mt-6">See {sib.name}</a>
            </aside>
          )}
        </div>
      ) : (
        <div class="mt-10 space-y-12">
          {categories.map((c) => (
            <div>
              <h3 class="font-serif text-2xl text-navy-900" data-reveal>{c.eyebrow}</h3>
              <ul class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
                {c.items.map((slug, i) => {
                  const s = bySlug[slug];
                  return (
                    <li data-reveal style={`--d:${i * 50}ms`}>
                      <a href={svcPath(s, location)} class="group flex h-full items-center justify-between gap-3 rounded-xl border border-navy-900/10 bg-white px-5 py-5 transition hover:border-gold-500 hover:shadow-md">
                        <span class="font-serif text-lg leading-snug text-navy-900">{s.title}</span>
                        <span class="text-gold-700 transition group-hover:translate-x-1"><Icon name="arrow" size={18} /></span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
          {extra && (
            <div>
              <h3 class="font-serif text-2xl text-navy-900" data-reveal>Everything we offer in {location.city}</h3>
              <div class="mt-6 grid gap-5 md:grid-cols-2 lg:grid-cols-3">
                {extra.groups.map((g, i) => (
                  <div class="rounded-2xl border border-navy-900/10 bg-white p-7" data-reveal style={`--d:${(i % 3) * 60}ms`}>
                    <h4 class="font-serif text-xl text-navy-900">{g.title}</h4>
                    <ul class="mt-4 space-y-2 text-mist">
                      {g.items.map((it) => <li class="flex gap-3"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-500"></span>{it}</li>)}
                    </ul>
                    {g.note && <p class="mt-4 text-sm font-semibold text-navy-900">{g.note}</p>}
                  </div>
                ))}
              </div>
            </div>
          )}
          {extra && extra.programs.length > 0 && (
            <div>
              <h3 class="font-serif text-2xl text-navy-900" data-reveal>Care management programs</h3>
              <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
                {extra.programs.map((g, i) => (
                  <div class="rounded-2xl bg-navy-900 p-7 text-cream-100" data-reveal style={`--d:${i * 60}ms`}>
                    <h4 class="font-serif text-xl text-gold-300">{g.title}</h4>
                    <ul class="mt-4 space-y-2 text-cream-200">{g.items.map((it) => <li class="flex gap-3"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-400"></span>{it}</li>)}</ul>
                  </div>
                ))}
              </div>
              <p class="mt-5 text-mist" data-reveal>Learn more about <a href="/ecm" class="link-underline text-navy-900">Enhanced Care Management</a>.</p>
            </div>
          )}
          {dentalSib && (
            <p class="text-lg text-mist" data-reveal>Looking for dental care? Visit <a href={`/locations/${dentalSib.id}`} class="link-underline text-navy-900">{dentalSib.name}</a> in {location.city}.</p>
          )}
        </div>
      )}
    </div>
  </section>

  {extra && (
    <section class="section bg-cream-100">
      <div class="container-x">
        <p class="eyebrow" data-reveal>Insurance</p>
        <h2 class="h-section mt-5 max-w-3xl text-navy-900" data-reveal style="--d:80ms">Insurance we accept <em>in {location.city}.</em></h2>
        <div class="mt-10 grid gap-8 lg:grid-cols-12">
          {extra.insurance.medical.length > 0 && (
            <div class="lg:col-span-8" data-reveal>
              <h3 class="text-xs font-semibold tracking-widest text-gold-700 uppercase">Medical insurance</h3>
              <ul class="mt-4 flex flex-wrap gap-2">{extra.insurance.medical.map((n) => <li class="rounded-full border border-navy-900/15 bg-white px-4 py-2 text-sm text-navy-900">{n}</li>)}</ul>
            </div>
          )}
          <div class="lg:col-span-4" data-reveal style="--d:80ms">
            <h3 class="text-xs font-semibold tracking-widest text-gold-700 uppercase">Dental insurance</h3>
            <ul class="mt-4 flex flex-wrap gap-2">{extra.insurance.dental.map((n) => <li class="rounded-full border border-navy-900/15 bg-white px-4 py-2 text-sm text-navy-900">{n}</li>)}</ul>
          </div>
        </div>
        <p class="mt-8 max-w-2xl text-mist" data-reveal>Don’t see your plan? Call us at {location.phone} and we will check. We also welcome self-pay patients. <a href="/resources/insurances" class="link-underline text-navy-900">See all accepted insurance</a>.</p>
      </div>
    </section>
  )}

  {extra && extra.gallery.length > 0 && (
    <section id="gallery" class="section bg-cream-50">
      <div class="container-x">
        <p class="eyebrow" data-reveal>Clinic gallery</p>
        <h2 class="h-section mt-5 max-w-3xl text-navy-900" data-reveal style="--d:80ms">A look inside <em>our {location.city} clinic.</em></h2>
        <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {extra.gallery.map((g, i) => (
            <li data-reveal style={`--d:${(i % 3) * 70}ms`}>
              <button type="button" data-gallery-open={i} aria-label={`Open photo ${i + 1} of ${extra.gallery.length}`} class="group relative block w-full overflow-hidden rounded-2xl bg-cream-200">
                <img src={g.src} alt={g.alt} width="512" height="341" loading="lazy" class="aspect-[3/2] w-full object-cover transition duration-700 group-hover:scale-105" />
                <span class="absolute inset-0 bg-navy-950/0 transition group-hover:bg-navy-950/20"></span>
              </button>
            </li>
          ))}
        </ul>
      </div>
    </section>
    <dialog id="gallery-dialog" class="m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-navy-950/90 backdrop:backdrop-blur-sm" aria-label="Clinic photo viewer">
      <div class="grid h-full w-full place-items-center p-4" data-gallery-backdrop>
        <img id="gallery-img" src="" alt="" class="max-h-[85vh] max-w-full rounded-xl object-contain shadow-2xl" />
        <button type="button" data-gallery-close aria-label="Close" class="absolute right-4 top-4 grid h-12 w-12 place-items-center rounded-full bg-white/10 text-white transition hover:bg-white/25">✕</button>
        <button type="button" data-gallery-prev aria-label="Previous photo" class="absolute left-3 top-1/2 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full bg-white/10 text-2xl text-white transition hover:bg-white/25">‹</button>
        <button type="button" data-gallery-next aria-label="Next photo" class="absolute right-3 top-1/2 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full bg-white/10 text-2xl text-white transition hover:bg-white/25">›</button>
        <p id="gallery-count" class="absolute bottom-4 left-1/2 -translate-x-1/2 text-sm text-white/80"></p>
      </div>
    </dialog>
    <script define:vars={{ photos: extra.gallery }}>
      const dlg = document.getElementById('gallery-dialog');
      const img = document.getElementById('gallery-img');
      const cnt = document.getElementById('gallery-count');
      let cur = 0;
      const show = (i) => { cur = (i + photos.length) % photos.length; img.src = photos[cur].src; img.alt = photos[cur].alt; cnt.textContent = `${cur + 1} / ${photos.length}`; };
      document.querySelectorAll('[data-gallery-open]').forEach((b) => b.addEventListener('click', () => { show(Number(b.dataset.galleryOpen)); dlg.showModal(); }));
      dlg.querySelector('[data-gallery-close]').addEventListener('click', () => dlg.close());
      dlg.querySelector('[data-gallery-prev]').addEventListener('click', () => show(cur - 1));
      dlg.querySelector('[data-gallery-next]').addEventListener('click', () => show(cur + 1));
      dlg.addEventListener('click', (e) => { if (e.target.hasAttribute('data-gallery-backdrop')) dlg.close(); });
      dlg.addEventListener('keydown', (e) => { if (e.key === 'ArrowLeft') show(cur - 1); if (e.key === 'ArrowRight') show(cur + 1); });
    </script>
  )}

  <section class="bg-cream-100 section">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow" data-reveal>Visit us</p>
        <h2 class="h-section mt-5 text-navy-900" data-reveal style="--d:80ms">Find us in <em>{location.city}.</em></h2>
        <p class="mt-6 text-lg leading-relaxed text-mist" data-reveal style="--d:120ms">{location.address}<br />{location.cityLine}</p>
        <p class="mt-6 text-lg leading-relaxed text-mist" data-reveal style="--d:160ms">We accept many insurance plans, including Medi-Cal and Medicare. Bring your ID and insurance card to your first visit.</p>
        {extra && (
          <div class="mt-8" data-reveal style="--d:180ms">
            <h3 class="font-serif text-xl text-navy-900">Hours</h3>
            <dl class="mt-3 divide-y divide-navy-900/10 border-y border-navy-900/10 text-mist">
              {extra.hours.map(([d, h]) => <div class="hours-row -mx-3 flex justify-between gap-3 rounded-lg px-3 py-2 transition-colors" data-day={d}><dt class="flex items-center gap-1.5 font-semibold text-navy-900">{d}<span class="today-badge hidden rounded-full bg-gold-500 px-1.5 py-0.5 text-[0.6rem] font-bold tracking-wider text-navy-950 uppercase">Today</span></dt><dd class="text-right sm:whitespace-nowrap">{h}</dd></div>)}
            </dl>
            <script is:inline>
              (function () {
                try {
                  // Use the clinic's time zone so the right day shows for every visitor.
                  var today = new Intl.DateTimeFormat('en-US', { weekday: 'long', timeZone: 'America/Los_Angeles' }).format(new Date());
                  document.querySelectorAll('.hours-row').forEach(function (r) {
                    if (r.getAttribute('data-day') !== today) return;
                    r.classList.add('bg-gold-500/15', 'ring-1', 'ring-gold-500/50');
                    r.querySelector('.today-badge').classList.remove('hidden');
                    r.querySelector('dd').classList.add('text-navy-900');
                    r.setAttribute('aria-current', 'date');
                  });
                } catch (e) {}
              })();
            </script>
            <p class="mt-4 text-mist">Email: <a href={`mailto:${extra.email}`} class="link-underline text-navy-900">{extra.email}</a></p>
          </div>
        )}
        <div class="mt-8 flex flex-wrap gap-3" data-reveal style="--d:200ms">
          <a href={`tel:${location.tel}`} class="btn btn-navy"><Icon name="phone" size={18} /> {location.phone}</a>
          <a href={dirHref} target="_blank" rel="noopener" class="btn btn-outline">Get directions</a>
        </div>
      </div>
      <div class="lg:col-span-7" data-reveal style="--d:120ms">
        <iframe title={`Map of ${location.name}`} src={mapSrc} loading="lazy" class="h-96 w-full rounded-2xl border-0 shadow-lg lg:h-full lg:min-h-[26rem]" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>

  <section id="contact" class="section bg-cream-50">
    <div class="container-x grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow" data-reveal>Get in touch</p>
        <h2 class="h-section mt-5 text-navy-900" data-reveal style="--d:80ms">Message our <em>{location.city} team.</em></h2>
        <p class="mt-6 text-lg leading-relaxed text-mist" data-reveal style="--d:160ms">Send us a note and a team member at {location.name} will reach out. Prefer to talk? Call {location.phone}.</p>
      </div>
      <div class="lg:col-span-7" data-reveal style="--d:120ms"><ContactForm client:visible /></div>
    </div>
  </section>

  <section class="on-dark bg-navy-950 section">
    <div class="container-x">
      <p class="eyebrow" data-reveal>Other locations</p>
      <h2 class="h-section mt-5 max-w-3xl" data-reveal style="--d:80ms">6 more clinics <em>across Tulare County.</em></h2>
      <ul class="mt-10 grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-3">
        {others.map((x) => (
          <li class="bg-navy-950">
            <a href={`/locations/${x.id}`} class="group flex h-full items-center justify-between gap-4 p-7 transition hover:bg-navy-900">
              <div>
                <p class="text-xs tracking-widest text-gold-400 uppercase">{x.city} · {x.type}</p>
                <p class="mt-2 font-serif text-xl">{x.name}</p>
                <p class="mt-1 text-sm text-cream-200/80">{x.address}, {x.cityLine}</p>
              </div>
              <span class="text-gold-400 transition group-hover:translate-x-1"><Icon name="arrow" size={20} /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
