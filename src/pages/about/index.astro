---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Icon from '../../components/ui/Icon.astro';
import { external } from '../../data/about';

const values = [
  ['Welcoming and easy to reach', 'We offer walk-in visits when available and telemedicine when it fits, so care is simple and safe to get.'],
  ['Faith-based and loving', 'We follow the words, “So in everything, do to others what you would have them do to you,” in every visit.'],
  ['Affordable for everyone', 'We take cash and most insurance plans, including Medicare. No one is turned away because they cannot pay, and a sliding fee is based on family size and income.'],
  ['Culturally sensitive', 'Our providers speak English, Spanish, Hindi, Urdu, Punjabi, French and basic Wolof.'],
];
const links = [
  ['Our Office', 'See our clinics in five communities.', '/about/our-office', false],
  ['Management', 'Meet the leaders behind the clinic.', '/about/management', false],
  ['Sobre Nosotros', 'Lea nuestra historia en español.', '/about/sobre-nosotros', false],
  ['Careers', 'Join our team. Opens our job site.', external.careers, true],
  ['OB/GYN Careers', 'Build a women’s health practice with us.', '/about/ob-gyn-careers', false],
  ['HPSA', 'Learn about health professional shortage areas. Opens another site.', external.hpsa, true],
] as const;
---
<BaseLayout title="About Us | Living Water Clinic" description="Living Water Clinic – Clínica Agua Viva is a faith-based family medicine practice with seven locations in Lindsay, Woodlake, Porterville, Visalia and Selma, California." solidHeader>
  <PageHero crumbs={[['Home', '/'], ['About']]} eyebrow="About us" title="Care that feels like <em>family.</em>" text="Living Water Clinic, also called Clínica Agua Viva, is a faith-based family medicine practice serving Tulare County with compassion." image="/images/about.jpg" imageAlt="Living Water Clinic care team with a patient">
    <a href="/#contact" class="btn btn-gold">Book a visit</a>
    <a href="/contact" class="btn btn-outline-light">Find a clinic</a>
  </PageHero>

  <section class="section bg-cream-50">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow" data-reveal>Our story</p>
        <h2 class="h-section mt-5 text-navy-900" data-reveal style="--d:80ms">Trusted care, <em>close to home.</em></h2>
      </div>
      <div class="space-y-5 text-lg leading-relaxed text-mist lg:col-span-7">
        <p data-reveal>Living Water Community Health and Wellness Clinic brings together highly trained practitioners, a community-focused approach and caring, patient-centered medicine. We are a faith-based family medicine practice, a patient-centered medical home and a parachurch ministry.</p>
        <p data-reveal style="--d:60ms">With clinics in Porterville, Lindsay, Woodlake, Visalia and Selma, plus a mobile clinic serving nearby areas, it is easy to get the care you need, including urgent care and telemedicine.</p>
        <p data-reveal style="--d:120ms">To learn more about our family medicine, specialty and wellness services, book online or call the clinic nearest you.</p>
      </div>
    </div>
  </section>

  <section class="section bg-cream-100">
    <div class="container-x">
      <p class="eyebrow" data-reveal>What guides us</p>
      <h2 class="h-section mt-5 max-w-3xl text-navy-900" data-reveal style="--d:80ms">Four promises <em>to every patient.</em></h2>
      <ul class="mt-12 grid gap-5 sm:grid-cols-2">
        {values.map(([h, t], i) => (
          <li class="rounded-2xl border border-navy-900/10 bg-white p-8" data-reveal style={`--d:${i * 70}ms`}>
            <span class="font-serif text-2xl text-gold-700">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 font-serif text-2xl text-navy-900">{h}</h3>
            <p class="mt-3 text-mist">{t}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="on-dark bg-navy-950 section">
    <div class="container-x">
      <p class="eyebrow" data-reveal>Explore</p>
      <h2 class="h-section mt-5" data-reveal style="--d:80ms">More about <em>Living Water.</em></h2>
      <ul class="mt-10 grid gap-px overflow-hidden rounded-2xl border border-white/10 bg-white/10 sm:grid-cols-2 lg:grid-cols-3">
        {links.map(([t, d, href, isExt]) => (
          <li class="bg-navy-950">
            <a href={href} target={isExt ? '_blank' : undefined} rel={isExt ? 'noopener noreferrer' : undefined} class="group flex h-full items-center justify-between gap-4 p-7 transition hover:bg-navy-900">
              <div><p class="font-serif text-xl">{t}{isExt && <span class="sr-only"> (opens in a new tab)</span>}</p><p class="mt-2 text-sm text-cream-200/80">{d}</p></div>
              <span class="text-gold-400 transition group-hover:translate-x-1"><Icon name="arrow" size={20} /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section bg-cream-100 text-center">
    <div class="container-x">
      <h2 class="h-section mx-auto max-w-3xl text-navy-900" data-reveal>Ready to meet <em>your care team?</em></h2>
      <div class="mt-9 flex flex-wrap justify-center gap-3" data-reveal style="--d:100ms">
        <a href="/#contact" class="btn btn-navy">Request an appointment</a>
        <a href="/contact" class="btn btn-outline">See our locations</a>
      </div>
    </div>
  </section>
</BaseLayout>
