---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Icon from '../../components/ui/Icon.astro';
import { locations } from '../../data/site';
const sorted = [...locations].sort((a, b) => a.city.localeCompare(b.city) || a.name.localeCompare(b.name));
const offers = ['Family medicine', 'Walk-in care', 'Telemedicine', 'Urgent care', 'Specialty support', 'Dental care'];
---
<BaseLayout title="Our Office | Living Water Clinic" description="Visit Living Water Clinic in Porterville, Lindsay, Visalia, Selma and Woodlake, California. Family medicine, walk-in care, telemedicine, urgent care and specialty support." solidHeader>
  <PageHero crumbs={[['Home', '/'], ['About', '/about'], ['Our Office']]} eyebrow="About us" title="Our <em>offices.</em>" text="Our clinics in Porterville, Lindsay, Visalia, Selma and Woodlake are welcoming hubs for patient-focused care." image="/images/care.jpg" imageAlt="Smiling Living Water Clinic team" />

  <section class="section bg-cream-50">
    <div class="container-x grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <p class="eyebrow" data-reveal>Every location</p>
        <h2 class="h-section mt-5 text-navy-900" data-reveal style="--d:80ms">One team, <em>many ways to care.</em></h2>
      </div>
      <div class="lg:col-span-7">
        <p class="text-lg leading-relaxed text-mist" data-reveal>Each location offers a wide range of services designed for individuals and families in our community. Whether you come for preventive care, long-term condition support or a same-day visit, our team gives you quality care with convenience, respect and a personal touch.</p>
        <ul class="mt-8 flex flex-wrap gap-3" data-reveal style="--d:100ms">
          {offers.map((o) => <li class="inline-flex items-center gap-2 rounded-full border border-navy-900/15 bg-white px-4 py-2 text-navy-900"><span class="text-gold-700"><Icon name="check" size={16} /></span>{o}</li>)}
        </ul>
        <p class="mt-6 text-sm text-mist">Services can differ by clinic. Call your nearest office to check.</p>
      </div>
    </div>
  </section>

  <section class="section bg-cream-100">
    <div class="container-x">
      <h2 class="h-section text-navy-900" data-reveal>Find your <em>clinic.</em></h2>
      <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {sorted.map((x, i) => (
          <li data-reveal style={`--d:${i * 50}ms`}>
            <a href={`/locations/${x.id}`} class="group block h-full rounded-2xl border border-navy-900/10 bg-white p-8 transition hover:border-gold-500 hover:shadow-lg">
              <p class="text-xs font-semibold tracking-widest text-gold-700 uppercase">{x.city} · {x.type}</p>
              <h3 class="mt-3 font-serif text-2xl text-navy-900">{x.name}</h3>
              <p class="mt-4 text-mist">{x.address}<br />{x.cityLine}</p>
              <p class="mt-3 font-semibold text-navy-900">{x.phone}</p>
              <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-gold-700">View location <span class="transition group-hover:translate-x-1"><Icon name="arrow" size={16} /></span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
