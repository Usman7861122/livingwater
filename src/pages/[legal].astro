---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import { legal, legalContact } from '../data/legal';
export function getStaticPaths() { return legal.map((x) => ({ params: { legal: x.slug }, props: { doc: x } })); }
const { doc } = Astro.props;
const related = legal.filter((x) => x.slug !== doc.slug);
---
<BaseLayout title={`${doc.title} | Living Water Clinic`} description={doc.desc} solidHeader>
  <PageHero crumbs={[['Home', '/'], [doc.title]]} eyebrow="Legal" title={doc.title} text={`Last updated: ${legalContact.updated}`} />
  <section class="section bg-cream-50"><div class="container-x grid gap-12 lg:grid-cols-12">
    <article class="lg:col-span-8">
      <p class="text-lg leading-relaxed text-mist">{doc.intro}</p>
      {doc.sections.map((s) => (<>
        <h2 class="mt-10 font-serif text-2xl text-navy-900">{s.h}</h2>
        {s.p?.map((t) => <p class="mt-3 leading-relaxed text-mist">{t}</p>)}
        {s.ul && s.ul.length > 0 && <ul class="mt-3 space-y-2 text-mist">{s.ul.map((t) => <li class="flex gap-3"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-500"></span>{t}</li>)}</ul>}
      </>))}
      {doc.slug === 'cookie-policy' && <button type="button" data-cookie-open class="btn btn-navy mt-8">Open cookie settings</button>}
    </article>
    <aside class="lg:col-span-4"><div class="sticky top-28 rounded-2xl border border-navy-900/10 bg-white p-6">
      <h2 class="font-serif text-xl text-navy-900">Other policies</h2>
      <ul class="mt-4 space-y-2">{related.map((x) => <li><a href={`/${x.slug}`} class="link-underline text-navy-900">{x.title}</a></li>)}</ul>
    </div></aside>
  </div></section>
</BaseLayout>
