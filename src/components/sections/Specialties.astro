---
import { specialties } from '../../data/site';
import Icon from '../ui/Icon.astro';
---

<section id="specialties" class="section on-dark overflow-hidden bg-navy-900">
  <div class="absolute -right-40 -top-40 h-[34rem] w-[34rem] rounded-full border border-gold-500/20" aria-hidden="true"></div>
  <div class="absolute -right-24 -top-24 h-[28rem] w-[28rem] rounded-full border border-gold-500/10" aria-hidden="true"></div>
  <div class="container-x relative">
    <div class="mx-auto max-w-3xl text-center">
      <p class="eyebrow light justify-center" data-reveal data-i18n="spec.eyebrow">Multi-Specialty</p>
      <h2 class="h-section mt-5" data-reveal style="--d:80ms" data-i18n="spec.title">More than just primary care. <em>Living Water is multi-specialty.</em></h2>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-cream-50/75" data-reveal style="--d:160ms" data-i18n="spec.text">One trusted clinic family for your primary care and the specialists you may need, so your care stays connected and close to home.</p>
    </div>

    <!-- Staggered 3-column layout; cards flip vertically -->
    <ul class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {specialties.map((s, i) => (
        <li class={i % 3 === 1 ? 'lg:translate-y-12' : ''} data-reveal style={`--d:${(i % 3) * 100}ms`}>
          <div class="flip flip-x h-[27rem] rounded-2xl" tabindex="0" data-flip>
            <div class="flip-inner rounded-2xl">
              <div class="flip-face bg-navy-950">
                <img src={s.img} alt="" width="900" height="1100" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-t from-navy-950/95 via-navy-950/25 to-navy-950/45"></div>
                <span class="absolute left-6 top-6 font-serif text-lg text-gold-300">{s.n}</span>
                <h3 class="absolute inset-x-0 bottom-0 p-6 text-3xl text-white" data-es={s.title.es}>{s.title.en}</h3>
              </div>
              <div class="flip-back flip-face flex flex-col items-center justify-center bg-cream-50 p-8 text-center text-navy-900">
                <span class="font-serif text-lg text-gold-700">{s.n}</span>
                <h3 class="mt-3 text-3xl" data-es={s.title.es}>{s.title.en}</h3>
                <p class="mt-4 max-w-xs text-mist" data-es={s.text.es}>{s.text.en}</p>
                <a href={s.href} class="btn btn-navy mt-7 !min-h-11 !px-5 !text-sm"><span data-i18n="common.learn">Learn more</span><Icon name="arrow" size={16} /></a>
              </div>
            </div>
          </div>
        </li>
      ))}
    </ul>
    <div class="h-12 hidden lg:block"></div>
    <p class="mt-6 text-center text-sm text-cream-50/60 md:hidden" data-i18n="common.tap">Tap a card to flip it.</p>
  </div>
</section>
