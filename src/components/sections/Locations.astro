---
import LocationsMap from '../islands/LocationsMap';
---

<section id="locations" class="section on-dark bg-navy-950">
  <div class="container-x">
    <div class="max-w-2xl">
      <p class="eyebrow light" data-reveal data-i18n="loc.eyebrow">Our Locations</p>
      <h2 class="h-section mt-5" data-reveal style="--d:80ms" data-i18n="loc.title">Seven clinics across <em>Tulare County.</em></h2>
      <p class="mt-5 text-lg text-cream-50/75" data-reveal style="--d:160ms" data-i18n="loc.text">Pick a clinic to see the map, address and phone number.</p>
    </div>
    <div class="mt-12" data-reveal>
      <LocationsMap client:visible />
    </div>
  </div>
</section>
