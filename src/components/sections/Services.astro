---
import Icon from '../ui/Icon.astro';
import { services } from '../../data/site';
---

<section id="services" class="section bg-cream-100">
  <div class="container-x">
    <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
      <div class="max-w-2xl">
        <p class="eyebrow" data-reveal data-i18n="services.eyebrow">Services We Offer</p>
        <h2 class="h-section mt-5 text-navy-900" data-reveal style="--d:80ms" data-i18n="services.title">Everyday care, <em>done with heart.</em></h2>
      </div>
      <a href="/services" class="btn btn-outline self-start md:self-auto" data-reveal><span data-i18n="services.cta">View all services</span><Icon name="arrow" size={18} /></a>
    </div>

    <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((s, i) => (
        <li data-reveal style={`--d:${(i % 4) * 90}ms`}>
          <div class="flip h-[24rem] rounded-2xl" tabindex="0" data-flip>
            <div class="flip-inner rounded-2xl">
              <!-- Front -->
              <div class="flip-face bg-navy-900">
                <img src={s.img} alt="" width="800" height="1000" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-t from-navy-950/90 via-navy-950/35 to-navy-950/10"></div>
                <div class="absolute inset-x-0 bottom-0 p-6 text-white">
                  <span class="mb-4 grid h-12 w-12 place-items-center rounded-full border border-white/40 bg-white/10 text-gold-300 backdrop-blur-sm"><Icon name={s.icon} size={24} /></span>
                  <h3 class="text-2xl leading-tight" data-es={s.title.es}>{s.title.en}</h3>
                </div>
              </div>
              <!-- Back -->
              <div class="flip-back flip-face flex flex-col justify-between bg-navy-900 p-7 text-cream-50">
                <div>
                  <span class="grid h-12 w-12 place-items-center rounded-full border border-gold-400/60 text-gold-300"><Icon name={s.icon} size={24} /></span>
                  <h3 class="mt-5 text-2xl text-gold-300" data-es={s.title.es}>{s.title.en}</h3>
                  <p class="mt-3 text-cream-50/80" data-es={s.text.es}>{s.text.en}</p>
                </div>
                <a href={s.href} class="btn btn-gold !min-h-11 self-start !px-5 !text-sm"><span data-i18n="common.learn">Learn more</span><Icon name="arrow" size={16} /></a>
              </div>
            </div>
          </div>
        </li>
      ))}
    </ul>
    <p class="mt-6 text-center text-sm text-mist md:hidden" data-i18n="common.tap">Tap a card to flip it.</p>
  </div>
</section>
