---
import { blog } from '../../data/site';
import Icon from '../ui/Icon.astro';
const [feature, ...rest] = blog;
---

<section id="blog" class="section bg-cream-50">
  <div class="container-x">
    <div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
      <div class="max-w-2xl">
        <p class="eyebrow" data-reveal data-i18n="blog.eyebrow">From Our Blog</p>
        <h2 class="h-section mt-5 text-navy-900" data-reveal style="--d:80ms" data-i18n="blog.title">Health tips & <em>community news</em></h2>
      </div>
      <a href="/blog" class="btn btn-outline self-start md:self-auto" data-reveal><span data-i18n="blog.cta">Read the blog</span><Icon name="arrow" size={18} /></a>
    </div>

    <div class="mt-14 grid gap-10 lg:grid-cols-12">
      <a href={feature.href} class="group lg:col-span-7" data-reveal>
        <div class="overflow-hidden rounded-3xl">
          <img src={feature.img} alt="" width="1600" height="1067" loading="lazy" class="aspect-[16/10] w-full object-cover transition-transform duration-[1400ms] ease-[var(--ease-lux)] group-hover:scale-105" />
        </div>
        <p class="eyebrow mt-6" data-es={feature.tag.es}>{feature.tag.en}</p>
        <h3 class="mt-3 text-3xl text-navy-900 transition-colors duration-300 group-hover:text-gold-700 md:text-4xl">{feature.title}</h3>
        <p class="mt-3 max-w-xl text-mist" data-es={feature.excerpt.es}>{feature.excerpt.en}</p>
      </a>
      <ul class="lg:col-span-5">
        {rest.map((p, i) => (
          <li class="border-t border-navy-900/10 first:border-t-0 lg:first:border-t" data-reveal style={`--d:${i * 80}ms`}>
            <a href={p.href} class="group flex items-center gap-5 py-5">
              <div class="h-20 w-24 shrink-0 overflow-hidden rounded-xl sm:h-24 sm:w-28">
                <img src={p.img} alt="" width="224" height="192" loading="lazy" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110" />
              </div>
              <div class="flex-1">
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-700" data-es={p.tag.es}>{p.tag.en}</p>
                <h3 class="mt-1 text-lg leading-snug text-navy-900 transition-colors duration-300 group-hover:text-gold-700 sm:text-xl">{p.title}</h3>
              </div>
              <Icon name="arrow" size={20} class="shrink-0 text-gold-500 transition-transform duration-500 group-hover:translate-x-2" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
