---
import Icon from '../ui/Icon.astro';
---

<section id="contact" class="section bg-cream-100">
  <div class="container-x grid gap-14 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <p class="eyebrow" data-reveal data-i18n="contact.eyebrow">Get In Touch</p>
      <h2 class="h-section mt-5 text-navy-900" data-reveal style="--d:80ms" data-i18n="contact.title">We’d love to <em>hear from you</em></h2>
      <p class="mt-6 text-lg leading-relaxed text-mist" data-reveal style="--d:160ms" data-i18n="contact.text">Book online in a few minutes. Prefer to talk? Call the clinic nearest you.</p>
      <ul class="mt-10 space-y-5" data-reveal style="--d:240ms">
        <li class="flex items-start gap-4"><span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-navy-900 text-gold-400"><Icon name="phone" size={20} /></span><div><p class="font-semibold text-navy-900" data-i18n="contact.call">Call a clinic</p><a href="#locations" class="link-underline text-mist" data-i18n="contact.callsub">See all phone numbers</a></div></li>
        <li class="flex items-start gap-4"><span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-navy-900 text-gold-400"><Icon name="pin" size={20} /></span><div><p class="font-semibold text-navy-900" data-i18n="contact.visit">Visit us</p><a href="#locations" class="link-underline text-mist" data-i18n="contact.visitsub">Seven locations in Tulare and Fresno Counties</a></div></li>
      </ul>
    </div>
    <div class="lg:col-span-7" data-reveal style="--d:120ms">
      <div class="rounded-3xl bg-white p-8 shadow-xl sm:p-10">
        <h3 class="font-serif text-2xl text-navy-900" data-es="Reserve su visita">Book your visit</h3>
        <p class="mt-3 text-mist" data-es="Elija su proveedor y una hora que le quede bien. Es rápido y fácil.">Choose your provider and a time that works for you. It is quick and easy.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="https://phreesia.me/LWCOnlineScheduling" target="_blank" rel="noopener noreferrer" class="btn btn-navy"><span data-es="Reservar en línea">Book online</span></a>
          <a href="https://patient.athenahealth.com/6501/" target="_blank" rel="noopener noreferrer" class="btn btn-outline"><span data-es="Portal del paciente">Patient Portal</span></a>
        </div>
        <p class="mt-6 text-sm text-mist" data-es="Para emergencias, llame al 911.">For emergencies, call 911.</p>
      </div>
    </div>
  </div>
</section>
