---
import ContactForm from '../islands/ContactForm';
import Icon from '../ui/Icon.astro';
---

<section id="contact" class="section bg-cream-100">
  <div class="container-x grid gap-14 lg:grid-cols-12">
    <div class="lg:col-span-5">
      <p class="eyebrow" data-reveal data-i18n="contact.eyebrow">Get In Touch</p>
      <h2 class="h-section mt-5 text-navy-900" data-reveal style="--d:80ms" data-i18n="contact.title">We’d love to <em>hear from you</em></h2>
      <p class="mt-6 text-lg leading-relaxed text-mist" data-reveal style="--d:160ms" data-i18n="contact.text">Send us a message and a team member will reach out. Prefer to talk? Call the clinic nearest you.</p>
      <ul class="mt-10 space-y-5" data-reveal style="--d:240ms">
        <li class="flex items-start gap-4"><span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-navy-900 text-gold-400"><Icon name="phone" size={20} /></span><div><p class="font-semibold text-navy-900" data-i18n="contact.call">Call a clinic</p><a href="#locations" class="link-underline text-mist" data-i18n="contact.callsub">See all phone numbers</a></div></li>
        <li class="flex items-start gap-4"><span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-navy-900 text-gold-400"><Icon name="pin" size={20} /></span><div><p class="font-semibold text-navy-900" data-i18n="contact.visit">Visit us</p><a href="#locations" class="link-underline text-mist" data-i18n="contact.visitsub">Seven locations in Tulare County</a></div></li>
      </ul>
    </div>
    <div class="lg:col-span-7" data-reveal style="--d:120ms">
      <ContactForm client:visible />
    </div>
  </div>
</section>
