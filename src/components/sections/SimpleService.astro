---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../ui/PageHero.astro';
import { locations } from '../../data/site';
import { providers } from '../../data/providers';
interface Props { title: string; slug: string; description: string; paras: string[]; clinicIds?: string[]; providerSlugs?: string[]; image?: string; imageAlt?: string; }
const { title, slug, description, paras, clinicIds, providerSlugs = [], image = '/images/care.jpg', imageAlt = '' } = Astro.props;
const clinics = locations.filter((x) => x.type === 'Medical' && (!clinicIds || clinicIds.includes(x.id)));
const people = providers.filter((p) => providerSlugs.includes(p.slug));
---
<BaseLayout title={`${title} | Living Water Clinic`} description={description} solidHeader>
  <PageHero crumbs={[['Home', '/'], ['Services', '/services/'], [title]]} eyebrow="Our services" title={title} text={paras[0]} image={image} imageAlt={imageAlt}>
    <a href="https://phreesia.me/LWCOnlineScheduling" target="_blank" rel="noopener noreferrer" class="btn btn-gold">Request an appointment</a>
    <a href="/locations/" class="btn btn-outline-light">Find a clinic</a>
  </PageHero>
  <section class="section bg-cream-50"><div class="container-x grid gap-12 lg:grid-cols-12">
    <div class="space-y-5 text-lg leading-relaxed text-mist lg:col-span-6">
      {paras.slice(1).map((t, i) => <p data-reveal style={`--d:${i * 60}ms`}>{t}</p>)}
      {people.length > 0 && (
        <div data-reveal>
          <h2 class="font-serif text-2xl text-navy-900">Our providers</h2>
          <ul class="mt-3 space-y-2">{people.map((p) => <li><a href={`/providers/${p.slug}/`} class="link-underline font-semibold text-navy-900">{p.name}{p.creds ? `, ${p.creds}` : ''}</a></li>)}</ul>
        </div>
      )}
    </div>
    <div class="lg:col-span-6">
      <h2 class="font-serif text-3xl text-navy-900" data-reveal>Call your clinic</h2>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2">
        {clinics.map((c, i) => (
          <li class="rounded-xl border border-navy-900/10 bg-white p-5" data-reveal style={`--d:${i * 50}ms`}>
            <p class="font-serif text-xl text-navy-900">{c.name}</p>
            <p class="mt-1 text-sm text-mist">{c.address}, {c.cityLine}</p>
            <a href={`tel:${c.tel}`} class="link-underline mt-2 inline-block font-semibold text-navy-900">{c.phone}</a>
          </li>
        ))}
      </ul>
    </div>
  </div></section>
</BaseLayout>
