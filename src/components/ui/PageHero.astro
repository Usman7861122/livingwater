---
interface Props {
  crumbs: [string, string?][];
  eyebrow: string;
  title: string; // may contain <em>
  text?: string;
  image?: string;
  imageAlt?: string;
  lang?: string;
}
const { crumbs, eyebrow, title, text, image, imageAlt = '', lang } = Astro.props;
---
<section class="on-dark relative overflow-hidden bg-navy-950 pt-36 pb-20 lg:pt-44" lang={lang}>
  <div class={`container-x grid items-center gap-12 ${image ? 'lg:grid-cols-12' : ''}`}>
    <div class={image ? 'lg:col-span-7' : 'max-w-3xl'}>
      <nav aria-label="Breadcrumb" class="text-sm text-cream-200/80" data-reveal>
        {crumbs.map(([label, href], i) => (<>{i > 0 && <span class="mx-2">/</span>}{href ? <a href={href} class="link-underline">{label}</a> : <span class="text-gold-400">{label}</span>}</>))}
      </nav>
      <p class="eyebrow mt-8" data-reveal style="--d:60ms">{eyebrow}</p>
      <h1 class="h-display mt-5" data-reveal style="--d:120ms" set:html={title} />
      {text && <p class="mt-6 max-w-xl text-lg leading-relaxed text-cream-200" data-reveal style="--d:180ms">{text}</p>}
      <div class="mt-9 flex flex-wrap gap-3" data-reveal style="--d:240ms"><slot /></div>
    </div>
    {image && (
      <div class="lg:col-span-5" data-reveal style="--d:200ms">
        <div class="relative">
          <div class="absolute -right-3 -bottom-3 h-full w-full rounded-2xl border border-gold-400/60"></div>
          <img src={image} alt={imageAlt} width="1600" height="1067" class="relative aspect-[4/5] w-full rounded-2xl object-cover" fetchpriority="high" />
        </div>
      </div>
    )}
  </div>
</section>
