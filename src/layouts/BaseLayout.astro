---
import '../styles/global.css';
import Header from '../components/islands/Header';
import SideDots from '../components/islands/SideDots';
import MobileCta from '../components/sections/MobileCta.astro';
import BookingModal from '../components/islands/BookingModal';
import Footer from '../components/sections/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  solidHeader?: boolean;
  dots?: boolean;
}
const { title, description = site.description, solidHeader = false, dots = false } = Astro.props;
const fullTitle = title && title.includes('|') ? title : title ? `${title} | ${site.name}` : `${site.name} · ${site.nameEs}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f2347" />
    <link rel="icon" href="/images/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap"
    />
    <title>{fullTitle}</title>
    <slot name="head" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="min-h-screen">
    <a href="#main" class="sr-only z-[70] rounded-full bg-gold-500 px-5 py-3 font-semibold text-navy-950 focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Skip to content</a>
    <Header client:load solid={solidHeader} />
    {dots && <SideDots client:idle />}
    <main id="main"><slot /></main>
    <Footer />
    <MobileCta />
    <BookingModal client:idle />

    <div id="cookie-banner" role="dialog" aria-live="polite" aria-label="Cookie consent" hidden class="fixed bottom-3 left-3 right-3 z-[80] flex flex-wrap items-center gap-x-4 gap-y-2 rounded-xl border border-navy-900/10 bg-white px-4 py-3 text-navy-900 shadow-xl sm:right-auto sm:max-w-md">
      <p class="min-w-0 flex-1 basis-48 text-xs leading-snug text-mist"><span data-es="Usamos cookies para que el sitio funcione.">We use cookies to make this site work.</span> <a href="/cookie-policy" class="link-underline font-semibold text-navy-900" data-es="Más información">Learn more</a></p>
      <div class="flex gap-2">
        <button type="button" data-cookie="necessary" class="rounded-full border border-navy-900/25 px-3.5 py-1.5 text-xs font-semibold transition hover:bg-navy-900/5" data-es="Solo necesarias">Necessary only</button>
        <button type="button" data-cookie="all" class="rounded-full bg-navy-900 px-3.5 py-1.5 text-xs font-semibold text-white transition hover:bg-navy-800" data-es="Aceptar">Accept</button>
      </div>
    </div>

    <script>
      import { es } from '../data/i18n';

      // --- Language swap for static text (React islands handle their own) ---
      const apply = (lang: string) => {
        document.querySelectorAll<HTMLElement>('[data-i18n],[data-es]').forEach((el) => {
          if (!el.dataset.en) el.dataset.en = el.innerHTML;
          const next = lang === 'es' ? (el.dataset.i18n ? es[el.dataset.i18n] : el.dataset.es) : el.dataset.en;
          if (next) el.innerHTML = next;
        });
        document.documentElement.lang = lang;
      };
      let saved = 'en';
      try { saved = localStorage.getItem('lw-lang') === 'es' ? 'es' : 'en'; } catch {}
      if (saved === 'es') apply('es');
      window.addEventListener('lw:lang', (e) => apply((e as CustomEvent).detail));


      // --- Cookie consent ---
      const banner = document.getElementById('cookie-banner');
      const KEY = 'lw-consent';
      const get = () => { try { return localStorage.getItem(KEY); } catch { return null; } };
      const set = (v: string) => { try { localStorage.setItem(KEY, v); } catch {} document.documentElement.dataset.consent = v; window.dispatchEvent(new CustomEvent('lw:consent', { detail: v })); };
      const show = () => { if (banner) { banner.hidden = false; (banner.querySelector('[data-cookie="all"]') as HTMLElement | null)?.focus({ preventScroll: true }); } };
      if (get()) document.documentElement.dataset.consent = get()!; else setTimeout(show, 600);
      banner?.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest('[data-cookie]') as HTMLElement | null;
        if (!b) return;
        set(b.dataset.cookie!); banner.hidden = true;
      });
      document.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('[data-cookie-open]')) show(); });

      // --- Flip cards on touch devices ---
      document.addEventListener('click', (e) => {
        const card = (e.target as HTMLElement).closest('[data-flip]');
        if (!card || (e.target as HTMLElement).closest('a') || !matchMedia('(hover: none)').matches) return;
        document.querySelectorAll('[data-flip].is-flipped').forEach((c) => c !== card && c.classList.remove('is-flipped'));
        card.classList.toggle('is-flipped');
      });

      // --- Scroll reveal ---
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }),
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
