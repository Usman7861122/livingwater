---
import '../styles/global.css';
import Header from '../components/islands/Header';
import SideDots from '../components/islands/SideDots';
import MobileCta from '../components/sections/MobileCta.astro';
import BookingModal from '../components/islands/BookingModal';
import Footer from '../components/sections/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  solidHeader?: boolean;
  dots?: boolean;
}
const { title, description = site.description, solidHeader = false, dots = false } = Astro.props;
const fullTitle = title && title.includes('|') ? title : title ? `${title} | ${site.name}` : `${site.name} · ${site.nameEs}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f2347" />
    <link rel="icon" href="/images/logo.png" />
    <title>{fullTitle}</title>
    <slot name="head" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="min-h-screen">
    <a href="#main" class="sr-only z-[70] rounded-full bg-gold-500 px-5 py-3 font-semibold text-navy-950 focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Skip to content</a>
    <Header client:load solid={solidHeader} />
    {dots && <SideDots client:idle />}
    <main id="main"><slot /></main>
    <Footer />
    <MobileCta />
    <BookingModal client:idle />

    <div id="cookie-banner" role="dialog" aria-modal="false" aria-labelledby="ck-title" hidden class="fixed bottom-3 left-3 right-3 z-[80] max-h-[calc(100svh-1.5rem)] overflow-y-auto rounded-2xl border border-gold-500/30 bg-navy-950 p-5 text-cream-50 shadow-2xl sm:right-auto sm:w-[26rem]">
      <div class="flex items-center gap-3">
        <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full border border-gold-500/40 text-gold-400" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a4 4 0 0 0 4.6 4.6A4 4 0 0 0 21 12.8z"/><path d="M8.5 11.5h.01M12 16h.01M15.5 12.5h.01M9 7.5h.01"/></svg>
        </span>
        <h2 id="ck-title" class="font-serif text-lg" data-es="Sus opciones de privacidad">Your privacy choices</h2>
      </div>
      <p class="mt-3 text-sm leading-relaxed text-cream-200/85"><span data-es="Usamos cookies para que el sitio funcione. Con su permiso, también podemos usar otras para entender cómo se usa. Usted tiene el control.">We use cookies to make this site work. With your OK, we may also use others to see how the site is used. You are in control.</span> <a href="/cookie-policy" class="link-underline font-semibold text-gold-300" data-es="Política de cookies">Cookie Policy</a></p>

      <div id="ck-main" class="mt-4 flex flex-wrap items-center gap-2">
        <button type="button" data-cookie="all" class="ck-btn ck-btn-gold" data-es="Aceptar todo">Accept all</button>
        <button type="button" data-cookie="necessary" class="ck-btn ck-btn-line" data-es="Rechazar opcionales">Reject optional</button>
        <button type="button" data-ck-choose class="ck-btn ck-btn-text" data-es="Elegir">Choose</button>
      </div>

      <div id="ck-panel" hidden class="mt-4">
        <ul class="space-y-2">
          <li class="ck-row"><div><p class="ck-t" data-es="Necesarias">Necessary</p><p class="ck-d" data-es="Mantienen el sitio funcionando y recuerdan su elección.">Keep the site working and remember this choice.</p></div><label class="ck-sw"><input type="checkbox" checked disabled aria-label="Necessary" /><span></span></label></li>
          <li class="ck-row"><div><p class="ck-t" data-es="Mapas y contenido externo">Maps and outside content</p><p class="ck-d" data-es="Google Maps carga solo si usted lo permite. Google puede recibir su IP.">Google Maps loads only if you allow it. Google may receive your IP address.</p></div><label class="ck-sw"><input type="checkbox" data-ck-pref="maps" aria-label="Maps and outside content" /><span></span></label></li>
          <li class="ck-row"><div><p class="ck-t" data-es="Analítica">Analytics</p><p class="ck-d" data-es="Nos ayudan a saber qué páginas son útiles. Hoy no usamos ninguna.">Help us learn which pages are useful. None in use today.</p></div><label class="ck-sw"><input type="checkbox" data-ck-pref="analytics" aria-label="Analytics" /><span></span></label></li>
          <li class="ck-row"><div><p class="ck-t" data-es="Publicidad">Marketing</p><p class="ck-d" data-es="Para anuncios y redes sociales. Hoy no usamos ninguna.">Used for ads and social media. None in use today.</p></div><label class="ck-sw"><input type="checkbox" data-ck-pref="marketing" aria-label="Marketing" /><span></span></label></li>
        </ul>
        <p id="ck-gpc" hidden class="mt-3 text-xs text-gold-300" data-es="Su navegador envía una señal de privacidad (GPC). La respetamos: analítica y publicidad quedan desactivadas.">Your browser sends a privacy signal (GPC). We honor it: analytics and marketing stay off.</p>
        <div class="mt-4 flex flex-wrap items-center gap-2">
          <button type="button" data-ck-save class="ck-btn ck-btn-gold" data-es="Guardar mis opciones">Save my choices</button>
          <button type="button" data-cookie="necessary" class="ck-btn ck-btn-line" data-es="Rechazar opcionales">Reject optional</button>
        </div>
      </div>
    </div>
    <style is:global>
      .ck-btn { min-height: 2.5rem; padding: 0 1.1rem; border-radius: 9999px; font-size: .875rem; font-weight: 600; cursor: pointer; transition: background .25s, color .25s, border-color .25s; }
      .ck-btn-gold { background: var(--color-gold-500); color: var(--color-navy-950); }
      .ck-btn-gold:hover { background: var(--color-gold-300); }
      .ck-btn-line { border: 1px solid rgba(255,255,255,.35); color: #fff; }
      .ck-btn-line:hover { border-color: var(--color-gold-400); color: var(--color-gold-300); }
      .ck-btn-text { color: var(--color-cream-200); padding: 0 .5rem; text-decoration: underline; text-underline-offset: 4px; }
      .ck-btn-text:hover { color: var(--color-gold-300); }
      .ck-btn:focus-visible, .ck-sw input:focus-visible + span { outline: 2px solid var(--color-gold-400); outline-offset: 2px; }
      .ck-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; border: 1px solid rgba(255,255,255,.12); background: rgba(255,255,255,.04); border-radius: .85rem; padding: .7rem .9rem; }
      .ck-t { font-size: .92rem; font-weight: 600; }
      .ck-d { margin-top: .15rem; font-size: .75rem; line-height: 1.4; color: rgba(245,239,227,.7); }
      .ck-sw { position: relative; flex-shrink: 0; display: inline-block; width: 2.75rem; height: 1.5rem; cursor: pointer; }
      .ck-sw input { position: absolute; inset: 0; opacity: 0; width: 100%; height: 100%; margin: 0; cursor: inherit; }
      .ck-sw span { position: absolute; inset: 0; border-radius: 9999px; background: rgba(255,255,255,.22); transition: background .25s; }
      .ck-sw span::after { content: ""; position: absolute; top: .2rem; left: .2rem; width: 1.1rem; height: 1.1rem; border-radius: 9999px; background: #fff; transition: transform .25s; }
      .ck-sw input:checked + span { background: var(--color-gold-500); }
      .ck-sw input:checked + span::after { transform: translateX(1.25rem); }
      .ck-sw input:disabled { cursor: not-allowed; }
      .ck-sw input:disabled + span { opacity: .65; }
    </style>
    <script>
      import { es } from '../data/i18n';

      // --- Language swap for static text (React islands handle their own) ---
      const apply = (lang: string) => {
        document.querySelectorAll<HTMLElement>('[data-i18n],[data-es]').forEach((el) => {
          if (!el.dataset.en) el.dataset.en = el.innerHTML;
          const next = lang === 'es' ? (el.dataset.i18n ? es[el.dataset.i18n] : el.dataset.es) : el.dataset.en;
          if (next) el.innerHTML = next;
        });
        document.documentElement.lang = lang;
      };
      let saved = 'en';
      try { saved = localStorage.getItem('lw-lang') === 'es' ? 'es' : 'en'; } catch {}
      if (saved === 'es') apply('es');
      window.addEventListener('lw:lang', (e) => apply((e as CustomEvent).detail));


      // --- Cookie consent ---
      // Stored as lw-consent = "all" | "necessary" | "custom" (+ lw-consent-prefs JSON for custom).
      // Nothing optional loads unless its own flag is on. Global Privacy Control / Do Not Track = analytics and marketing off.
      const banner = document.getElementById('cookie-banner');
      const KEY = 'lw-consent', PKEY = 'lw-consent-prefs';
      const nav = navigator as Navigator & { globalPrivacyControl?: boolean };
      const optedOut = nav.globalPrivacyControl === true || nav.doNotTrack === '1';
      type Prefs = { maps: boolean; analytics: boolean; marketing: boolean };
      const getChoice = () => { try { return localStorage.getItem(KEY); } catch { return null; } };
      const getPrefs = (): Prefs => {
        const c = getChoice();
        if (c === 'all') return { maps: true, analytics: true, marketing: true };
        if (c === 'custom') { try { const p = JSON.parse(localStorage.getItem(PKEY) || '{}'); return { maps: !!p.maps, analytics: !!p.analytics, marketing: !!p.marketing }; } catch {} }
        return { maps: false, analytics: false, marketing: false };
      };
      const effective = (): Prefs => { const p = getPrefs(); return optedOut ? { ...p, analytics: false, marketing: false } : p; };
      const publish = () => {
        const p = effective(); const root = document.documentElement;
        root.dataset.consent = getChoice() || (optedOut ? 'necessary' : '');
        (['maps', 'analytics', 'marketing'] as const).forEach((k) => { if (p[k]) root.dataset['consent' + k[0].toUpperCase() + k.slice(1)] = '1'; else delete root.dataset['consent' + k[0].toUpperCase() + k.slice(1)]; });
        window.dispatchEvent(new CustomEvent('lw:consent', { detail: p }));
      };
      const save = (choice: string, p?: Prefs) => { try { localStorage.setItem(KEY, choice); if (p) localStorage.setItem(PKEY, JSON.stringify(p)); } catch {} publish(); };
      const main = document.getElementById('ck-main'), panel = document.getElementById('ck-panel'), gpcNote = document.getElementById('ck-gpc');
      const boxes = () => document.querySelectorAll<HTMLInputElement>('[data-ck-pref]');
      const showPanel = (open: boolean) => { if (main) main.hidden = open; if (panel) panel.hidden = !open; };
      const syncBoxes = () => { const p = getPrefs(); boxes().forEach((b) => { const k = b.dataset.ckPref as keyof Prefs; const locked = optedOut && k !== 'maps'; b.checked = locked ? false : p[k]; b.disabled = locked; }); if (gpcNote) gpcNote.hidden = !optedOut; };
      const show = (openPanel = false) => { if (!banner) return; syncBoxes(); showPanel(openPanel); banner.hidden = false; (banner.querySelector(openPanel ? '[data-ck-save]' : '[data-cookie="all"]') as HTMLElement | null)?.focus({ preventScroll: true }); };
      if (getChoice() || optedOut) publish(); else setTimeout(() => show(false), 600);
      banner?.addEventListener('click', (e) => {
        const t = e.target as HTMLElement;
        if (t.closest('[data-ck-choose]')) { syncBoxes(); showPanel(true); return; }
        if (t.closest('[data-ck-save]')) {
          const p: Prefs = { maps: false, analytics: false, marketing: false };
          boxes().forEach((b) => { p[b.dataset.ckPref as keyof Prefs] = b.checked; });
          save(p.maps && p.analytics && p.marketing ? 'all' : (p.maps || p.analytics || p.marketing) ? 'custom' : 'necessary', p); banner.hidden = true; return;
        }
        const b = t.closest('[data-cookie]') as HTMLElement | null;
        if (!b) return;
        save(b.dataset.cookie!); banner.hidden = true;
      });
      document.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('[data-cookie-open]')) show(true); });

      // --- Click-to-load third-party maps (Google Maps only loads after consent or a click) ---
      const loadMap = (box: HTMLElement) => {
        const f = document.createElement('iframe');
        f.title = box.dataset.title || 'Map'; f.src = box.dataset.src || ''; f.loading = 'lazy';
        f.referrerPolicy = 'no-referrer-when-downgrade'; f.className = 'h-full w-full border-0';
        box.replaceChildren(f);
      };
      const mapBoxes = () => document.querySelectorAll<HTMLElement>('[data-map-embed]:not([data-loaded])');
      const autoMaps = () => { if (document.documentElement.dataset.consentMaps === '1') mapBoxes().forEach((b) => { b.dataset.loaded = '1'; loadMap(b); }); };
      autoMaps();
      window.addEventListener('lw:consent', autoMaps);
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('[data-map-load]');
        const box = btn?.closest('[data-map-embed]') as HTMLElement | null;
        if (box) { box.dataset.loaded = '1'; loadMap(box); }
      });

      // --- Flip cards on touch devices ---
      document.addEventListener('click', (e) => {
        const card = (e.target as HTMLElement).closest('[data-flip]');
        if (!card || (e.target as HTMLElement).closest('a') || !matchMedia('(hover: none)').matches) return;
        document.querySelectorAll('[data-flip].is-flipped').forEach((c) => c !== card && c.classList.remove('is-flipped'));
        card.classList.toggle('is-flipped');
      });

      // --- Scroll reveal ---
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } }),
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
